<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:DashDetective.Shared.Controls"
             xmlns:layout="using:DashDetective.Shared.Layout"
             xmlns:vm="using:DashDetective.Tabs.Storage"
             xmlns:sys="using:System"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="720"
             x:DataType="vm:StorageViewModel"
             x:Class="DashDetective.Tabs.Storage.StorageView">

    <!-- The design comp's Storage page: three drive summary cards (top row) over a Partitions table and a
         Disk Activity card (bottom row). Surfaces/typography come from src/Shared/Styles; the Disk Activity
         chart reuses the shared Sparkline. The page scrolls as a whole like the Dashboard/Network (not
         self-scrolling). Panels are added per phase. -->
    <!-- The Read/Write/Temp value tints are the palette's fixed Blue/Orange/Green, referenced directly
         rather than re-declared here under local names. They must be the FIXED keys, not ChartCpu /
         ChartNetUp / ChartGpu — those hold the same hex today but ThemeService overwrites them when the
         user picks a single accent, which would collapse the three tints into one. -->
    <UserControl.Resources>
        <!-- The Partitions table's columns, declared once and applied to both the header row and the
             row template through GridColumns.Definitions, so the two cannot drift apart. -->
        <sys:String x:Key="PartitionColumns">0.6*,1.3*,0.9*,0.9*,0.9*,0.9*</sys:String>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Rounded status pill (drive health): soft-tinted fill + matching text, both bound per card. -->
        <Style Selector="Border.healthPill">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.healthPill TextBlock">
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <!-- Slim rounded usage bar: a faint track (theme-aware) with the fill tinted per card. -->
        <Style Selector="ProgressBar.usage">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        </Style>
        <!-- One Read/Write/Temp readout: a muted label followed by a fixed-colour, tabular-nums value. -->
        <Style Selector="TextBlock.metricLabel">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="TextBlock.metricValue">
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <!-- ===== Drive picker (Disk Activity header) ===== -->
        <!-- A ToggleButton + chevron naming the drive on show, opening a list of the others. Chrome is
             deliberately light — it sits inside a panel header, so it reads as part of the title rather
             than as a form control. Mirrors File Explorer's Options toggle. -->
        <Style Selector="ToggleButton.drivePick">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.drivePick /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.drivePick:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        </Style>
        <Style Selector="ToggleButton.drivePick:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        </Style>
        <Style Selector="ToggleButton.drivePick TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <!-- One drive in the dropdown; the current one is marked rather than highlighted. -->
        <Style Selector="Border.driveOption">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.driveOption:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        </Style>
        <Style Selector="Border.driveOption TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="Border.driveOption.selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
        </Style>
        <!-- Disk Activity stat blocks: a muted label over a larger value. -->
        <Style Selector="TextBlock.diskStatLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="TextBlock.diskStatValue">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="16">

        <!-- ===== Row 1: drive summary cards (one per physical drive) ===== -->
        <ItemsControl ItemsSource="{Binding Drives}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Wraps below 280px per card, where the used/free split and the
                         read/write/temp row stop fitting on their lines. -->
                    <layout:UniformFlowPanel MinItemWidth="280" ColumnSpacing="16" RowSpacing="16"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DriveCard">
                    <Border Classes="panel">
                        <StackPanel Spacing="0">
                            <!-- Header: name + health pill. -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextStrong}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="1" Classes="healthPill"
                                        Background="{Binding HealthBackground}">
                                    <TextBlock Text="{Binding Health}" Foreground="{Binding HealthForeground}"/>
                                </Border>
                            </Grid>
                            <!-- Model subtitle. -->
                            <TextBlock Text="{Binding Model}" FontSize="11.5" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextSubtle}"
                                       TextTrimming="CharacterEllipsis"/>
                            <!-- Usage bar. -->
                            <ProgressBar Classes="usage" Value="{Binding UsagePercent}"
                                         Foreground="{Binding BarBrush}" Margin="0,0,0,7"/>
                            <!-- Used / free split. -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,14">
                                <TextBlock Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextSecondary}">
                                    <Run Text="{Binding Used}"/><Run Text=" used"/>
                                </TextBlock>
                                <TextBlock Grid.Column="1" FontSize="12" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextSecondary}">
                                    <Run Text="{Binding Free}"/><Run Text=" free"/>
                                </TextBlock>
                            </Grid>
                            <!-- Read / Write / Temp readouts (space-between). -->
                            <Grid ColumnDefinitions="*,*,*">
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Classes="metricLabel" Text="Read "/>
                                    <TextBlock Classes="metricValue" Text="{Binding Read}"
                                               Foreground="{StaticResource Blue}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Classes="metricLabel" Text="Write "/>
                                    <TextBlock Classes="metricValue" Text="{Binding Write}"
                                               Foreground="{StaticResource Orange}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Classes="metricLabel" Text="Temp "/>
                                    <TextBlock Classes="metricValue" Text="{Binding Temp}"
                                               Foreground="{StaticResource Green}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Row 2: Partitions table (left) · Disk Activity (right). The table keeps the wider
             share while both clear their minimums; below that they stack. -->
        <layout:WeightedRowPanel ColumnSpacing="16" RowSpacing="16">
            <Border layout:WeightedRowPanel.Weight="1.6" Classes="panel" MinWidth="440">
                <StackPanel Spacing="0">
                    <TextBlock Classes="panelTitle" Text="Partitions" Margin="0,0,0,10"/>
                    <!-- Column header: Vol · Label · File System · Type · Capacity · Free (Free right-aligned).
                         The data rows below share this exact column template so the columns stay aligned. -->
                    <Grid layout:GridColumns.Definitions="{StaticResource PartitionColumns}" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0" Classes="colHead" Text="VOL"/>
                        <TextBlock Grid.Column="1" Classes="colHead" Text="LABEL"/>
                        <TextBlock Grid.Column="2" Classes="colHead" Text="FILE SYSTEM"/>
                        <TextBlock Grid.Column="3" Classes="colHead" Text="TYPE"/>
                        <TextBlock Grid.Column="4" Classes="colHead" Text="CAPACITY"/>
                        <TextBlock Grid.Column="5" Classes="colHead" Text="FREE" TextAlignment="Right"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Partitions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PartitionRow">
                                <Border BorderBrush="{DynamicResource RowLine}" BorderThickness="0,0,0,1"
                                        Padding="0,9">
                                    <Grid layout:GridColumns.Definitions="{StaticResource PartitionColumns}">
                                        <TextBlock Grid.Column="0" Text="{Binding Vol}" FontSize="12.5"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding FileSystem}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Type}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Capacity}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Free}" FontSize="12.5"
                                                   TextAlignment="Right"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Disk Activity: the amber disk series on the shared Sparkline (fixed 0–100 axis + gridded
                 area fill, like the Dashboard), over three readouts. Chart, title and readouts all describe
                 the drive card selected above — one real physical disk, not the _Total average. -->
            <Border Classes="panel" MinWidth="280">
                <StackPanel Spacing="12">
                    <!-- Title + the drive on show. With several drives the name becomes a chevron toggle
                         that lists the others; with one there is nothing to switch to, so it stays text. -->
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock Classes="panelTitle" Text="Disk Activity" VerticalAlignment="Center"/>
                        <TextBlock Classes="panelTitle" Text="—" Margin="6,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Classes="panelTitle" VerticalAlignment="Center"
                                   IsVisible="{Binding !HasMultipleDrives}"
                                   Text="{Binding SelectedDrive.Name}"/>
                        <Panel IsVisible="{Binding HasMultipleDrives}">
                            <ToggleButton x:Name="DriveButton" Classes="drivePick"
                                          IsChecked="{Binding DrivePickerOpen, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding SelectedDrive.Name}"/>
                                    <TextBlock Text="▾"/>
                                </StackPanel>
                            </ToggleButton>
                            <!-- Light dismiss closes it on an outside click; picking a drive closes it
                                 through DrivePickerOpen, which SelectDrive clears. -->
                            <Popup PlacementTarget="{Binding #DriveButton}"
                                   Placement="BottomEdgeAlignedLeft" VerticalOffset="6"
                                   IsLightDismissEnabled="True"
                                   IsOpen="{Binding DrivePickerOpen, Mode=TwoWay}">
                                <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                                        CornerRadius="8" Padding="6" MinWidth="200"
                                        BoxShadow="0 8 24 0 #22000000">
                                    <ItemsControl ItemsSource="{Binding Drives}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DriveCard">
                                                <Button Classes="bare" Command="{Binding SelectCommand}"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch">
                                                    <Border Classes="driveOption"
                                                            Classes.selected="{Binding IsSelected}">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="✓" Margin="8,0,0,0"
                                                                       IsVisible="{Binding IsSelected}"
                                                                       Foreground="{DynamicResource Accent}"/>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                        </Panel>
                    </StackPanel>
                    <TextBlock Classes="cardSub" Text="{Binding DiskChartCaption}"/>
                    <controls:Sparkline Classes="chartPanel" Fill="True" ShowGrid="True" StrokeThickness="1.8"
                                        YMin="0" YMax="100"
                                        Stroke="{DynamicResource ChartStorage}" Points="{Binding DiskPoints}"
                                        AxisMaxLabel="100%" AxisMidLabel="50%" AxisMinLabel="0"
                                        AxisStartLabel="{Binding ChartRangeStart}" AxisEndLabel="now"
                                        StatusText="{Binding DiskChartStatus}"/>
                    <Grid ColumnDefinitions="*,*,*">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Classes="diskStatLabel" Text="Active time"/>
                            <TextBlock Classes="diskStatValue" Text="{Binding DiskActive}"
                                       Foreground="{DynamicResource ChartStorage}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
                            <TextBlock Classes="diskStatLabel" Text="Avg response"/>
                            <TextBlock Classes="diskStatValue" Text="{Binding DiskResponse}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                            <TextBlock Classes="diskStatLabel" Text="Queue"/>
                            <TextBlock Classes="diskStatValue" Text="{Binding DiskQueue}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </layout:WeightedRowPanel>
    </StackPanel>
</UserControl>
