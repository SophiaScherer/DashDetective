<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:layout="using:DashDetective.Shared.Layout"
             xmlns:vm="using:DashDetective.Tabs.Processes"
             xmlns:controls="using:DashDetective.Shared.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="720"
             x:DataType="vm:ProcessesViewModel"
             x:Name="Page"
             x:Class="DashDetective.Tabs.Processes.ProcessesView">

    <!-- Live process table, split into Apps and Background groups. Self-scrolling: the header stays
         fixed while the grouped list scrolls. Surfaces/typography come from src/Shared/Styles.
         The shared 7-column layout is repeated on the header and each row (like the Network and File
         Explorer tables). -->
    <UserControl.Resources>
        <!-- Shared row template for all three groups (Apps / Background / Windows) so the 7-column
             layout is defined once instead of copy-pasted per group; it must stay in sync with the
             sticky header's column definition above. Bindings are compiled (x:DataType); the row tap
             is handled in code-behind (OnRowTapped). -->
        <!-- The row context menu. Declared ONCE and shared by every row rather than sitting inside the
             row template, which would build one flyout and its items per row — a few thousand controls
             for a list this long. Nothing in it binds to a row: the right-click selects first, so every
             item acts on the page's selection. -->
        <MenuFlyout x:Key="RowMenu">
            <MenuItem Header="End task" Click="OnMenuEndTask"/>
            <MenuItem Header="Properties" Click="OnMenuProperties"/>
            <Separator/>
            <MenuItem Header="Expand / collapse" Click="OnMenuToggleExpand"
                      IsEnabled="{Binding SelectedHasChildren}"/>
            <MenuItem Header="Copy PID" Click="OnMenuCopyPid"/>
        </MenuFlyout>

        <DataTemplate x:Key="ProcRowTemplate" x:DataType="vm:ProcessRow">
            <Border Classes="procRow" Classes.selected="{Binding IsSelected}" Tapped="OnRowTapped"
                    ContextFlyout="{StaticResource RowMenu}">
                <!-- Columns come from the page view model, not the row, so every row and the sticky
                     header share one definition and one order, and stay aligned. Each cell's
                     Grid.Column is bound too: dragging a header moves the cells rather than rebuilding
                     the table. -->
                <Grid ColumnSpacing="4"
                      layout:GridColumns.Definitions="{Binding #Page.((vm:ProcessesViewModel)DataContext).ColumnLayout}">
                    <!-- Name cell: a depth indent + a fixed 16px chevron slot + status dot + name, all
                         inside the name column so revealing children never shifts the other columns.
                         The slot is reserved even without a chevron so parent and child names line
                         up. Name is pinned leftmost, so this cell never moves. -->
                    <Grid Grid.Column="{Binding #Page.((vm:ProcessesViewModel)DataContext).NameColumn}"
                          Margin="{Binding IndentMargin}" ColumnDefinitions="Auto,16,Auto,*">
                        <Button Grid.Column="0" Classes="bare checkBox" Classes.on="{Binding IsSelected}"
                                Click="OnRowCheckClick">
                            <Border>
                                <TextBlock Text="✓" IsVisible="{Binding IsSelected}"/>
                            </Border>
                        </Button>
                        <Button Grid.Column="1" Classes="bare chev" Click="OnChevronClick"
                                IsVisible="{Binding HasChildren}">
                            <TextBlock Text="{Binding ChevronGlyph}"/>
                        </Button>
                        <Ellipse Grid.Column="2" Width="7" Height="7" Margin="0,0,9,0"
                                 VerticalAlignment="Center" Fill="{Binding StatusBrush}"/>
                        <TextBlock Grid.Column="3" Classes="cellName" VerticalAlignment="Center"
                                   Text="{Binding Name}"/>
                    </Grid>
                    <TextBlock Grid.Column="{Binding #Page.((vm:ProcessesViewModel)DataContext).PidColumn}"
                               Classes="cellPid" Text="{Binding PidText}"/>
                    <TextBlock Grid.Column="{Binding #Page.((vm:ProcessesViewModel)DataContext).StatusColumn}"
                               Text="{Binding Status}" FontSize="11.5"
                               Foreground="{Binding StatusBrush}"/>
                    <TextBlock Grid.Column="{Binding #Page.((vm:ProcessesViewModel)DataContext).CpuColumn}"
                               Classes="cpuCell"
                               Classes.high="{Binding CpuHigh}" Classes.med="{Binding CpuMed}"
                               Text="{Binding CpuText}"/>
                    <TextBlock Grid.Column="{Binding #Page.((vm:ProcessesViewModel)DataContext).MemoryColumn}"
                               Classes="cellNum" Text="{Binding MemoryText}"/>
                    <TextBlock Grid.Column="{Binding #Page.((vm:ProcessesViewModel)DataContext).DiskColumn}"
                               Classes="cellNum" Text="{Binding DiskText}"/>
                    <TextBlock Grid.Column="{Binding #Page.((vm:ProcessesViewModel)DataContext).GpuColumn}"
                               Classes="cellNum" Text="{Binding GpuText}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Column header cells. Each is a chrome-less button (the shared Button.bare) that sorts by its
             column; the active column tints to the accent and shows a ↑/↓ arrow (bound to the
             SortColumn VMs). colHead / colHead.active / sortArrow are shared
             (src/Shared/Styles/SharedStyles.axaml). -->

        <!-- Expand/collapse chevron: a chrome-less button (the shared Button.bare) in the name cell. Its
             16px slot is reserved on every row (empty when the entry has no children) so names stay
             aligned parent-to-child; only that slot is local here.

             The hit target is that whole column, top of the row to bottom. Button.bare zeroes Padding and
             MinHeight, so left alone the button measures to the glyph and leaves a dead band above and below
             it INSIDE the slot: a click there missed the button, fell through to the row's Tapped, and
             selected instead of expanding. Stretch fills the cell; the negative margin then bleeds over the
             row's own 8px vertical padding, which the cell does not cover. The margin is negative so it does
             NOT feed back into measure — a MinHeight would make every row taller instead. KEEP THE -5 IN STEP
             WITH Border.procRow's Padding below. -->
        <Style Selector="Button.chev">
            <Setter Property="Width" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,-5"/>
        </Style>

        <!-- Selection box, on rows and on group headers. Hand-drawn on the shared Button.bare rather
             than a Fluent CheckBox, for the same reason the chevron is: that template carries a fixed
             20px box and its own minimum height, which set the row height between them and undid the
             tightening the rest of this file does. Told to be 15px, this one is 15px.
             .on is every row selected, .some is a group holding only part of its rows. -->
        <Style Selector="Button.checkBox">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.checkBox Border">
            <Setter Property="Background" Value="{DynamicResource FieldBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusHair}"/>
        </Style>
        <Style Selector="Button.checkBox:pointerover Border">
            <Setter Property="BorderBrush" Value="{DynamicResource TextTertiary}"/>
        </Style>
        <Style Selector="Button.checkBox.on Border">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Button.checkBox.some Border">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Button.checkBox TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- "Some" is a dash on the soft fill, so it never reads as a tick. -->
        <Style Selector="Button.checkBox.some TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </Style>

        <!-- Group section header (e.g. "Apps · 6"). -->
        <Style Selector="Border.groupHead">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
            <Setter Property="Padding" Value="16,5"/>
        </Style>
        <Style Selector="Border.groupHead TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <!-- Data rows. Background is Transparent here (a base style), NOT set locally on the row
             Border: a locally-set Background outranks the :pointerover / .selected style triggers
             (LocalValue beats StyleTrigger in Avalonia), so hover and selection would never paint.
             Setting it in the style keeps the whole row hit-testable for Tapped while letting the
             triggers below override it. -->
        <Style Selector="Border.procRow">
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RowLine}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.procRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        </Style>
        <!-- Selection wins over hover (defined after :pointerover) and is fill-only, like File Explorer's
             fileRow. A Border has ONE BorderBrush for every edge, so an accent bar down the left also
             repaints the bottom row rule in the accent — a 3px left and 1px bottom reading as one lopsided
             border, shaved on the first and last rows by the panel's rounded clip. Leaving the base
             BorderThickness alone keeps that rule neutral, and the fill carries the selection on its own.
             AccentSoft is DynamicResource so it tracks the runtime accent (ThemeService.SetAccent). -->
        <Style Selector="Border.procRow.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>
        <Style Selector="Border.procRow.selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>
        <Style Selector="Border.procRow TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- The chevron glyph, sized DELIBERATELY BELOW the cell text. These must stay BELOW the rule above:
             the glyph matches both selectors, and Avalonia settles that by declaration order rather than
             specificity, so declared alongside Button.chev the 9 lost to the row's 12.5. -->
        <Style Selector="Button.chev TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="Button.chev:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="TextBlock.cellName">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.cellPid">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <!-- Numeric cells: right-aligned, themed text. -->
        <Style Selector="TextBlock.cellNum">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <!-- CPU cell: themed by default, tinted amber/orange when elevated (classes from ProcessRow). -->
        <Style Selector="TextBlock.cpuCell">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style Selector="TextBlock.cpuCell.med">
            <Setter Property="Foreground" Value="#ffcf4d"/>
        </Style>
        <Style Selector="TextBlock.cpuCell.high">
            <Setter Property="Foreground" Value="#ff8a5c"/>
        </Style>

        <!-- Summary-card value. -->
        <Style Selector="TextBlock.sumValue">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- End task: a destructive-action button. Reddish when enabled (a row is selected), muted
             when disabled. Red is a fixed semantic colour (readable in both themes). -->
        <Style Selector="Button.endTask">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#29ff6b6b"/>
            <Setter Property="BorderBrush" Value="#4dff6b6b"/>
            <Setter Property="Foreground" Value="#ff8a5c"/>
        </Style>
        <Style Selector="Button.endTask:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3dff6b6b"/>
            <Setter Property="BorderBrush" Value="#66ff6b6b"/>
        </Style>
        <Style Selector="Button.endTask:disabled">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}"/>
        </Style>
        <Style Selector="Button.endTask:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" RowSpacing="14">

        <!-- ===== Summary strip: the action buttons keep their natural width on the right and the
             four cards flow in whatever space is left, wrapping rather than being squeezed. -->
        <Panel Grid.Row="0">
            <layout:UniformFlowPanel MinItemWidth="130" ColumnSpacing="12" RowSpacing="12">
            <Border Classes="card">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="cardLabel" Text="PROCESSES"/>
                    <TextBlock Classes="sumValue" Text="{Binding TotalProcessesText}"/>
                    <!-- Three category counts don't fit on one line, so let the breakdown wrap. -->
                    <TextBlock Classes="cardSub" TextWrapping="Wrap"
                               Text="{Binding ProcessBreakdownText}"/>
                </StackPanel>
            </Border>
            <Border Classes="card">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="cardLabel" Text="CPU"/>
                    <TextBlock Classes="sumValue" Foreground="{DynamicResource ChartCpu}"
                               Text="{Binding CpuUsageText}"/>
                </StackPanel>
            </Border>
            <Border Classes="card">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="cardLabel" Text="MEMORY"/>
                    <TextBlock Classes="sumValue" Foreground="{DynamicResource ChartMemory}"
                               Text="{Binding MemoryUsageText}"/>
                </StackPanel>
            </Border>
            <Border Classes="card">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="cardLabel" Text="THREADS"/>
                    <TextBlock Classes="sumValue" Foreground="#6ccb5f" Text="{Binding ThreadsText}"/>
                </StackPanel>
            </Border>
            </layout:UniformFlowPanel>
        </Panel>

        <!-- ===== Process table ===== -->
        <Border Grid.Row="1" Classes="panel" Padding="0" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">

            <!-- Filter and actions. The filter narrows the three groups to matching processes; Ctrl+F
                 or "/" puts the caret here and Esc clears it. End task and Properties sit on this row
                 rather than up in the summary strip, beside the rows they act on. Docked children
                 claim the right edge in declaration order, so Properties is outermost. -->
            <Border Grid.Row="0" Padding="16,8" BorderBrush="{DynamicResource Hairline}"
                    BorderThickness="0,0,0,1" Background="{DynamicResource CardBackground}">
                <DockPanel LastChildFill="False">
                    <!-- Tab fills in a running process name from what has been typed. -->
                    <controls:SearchField x:Name="FilterBox" DockPanel.Dock="Left"
                                          VerticalAlignment="Center"
                                          Width="300" Height="30"
                                          IconSize="13" TextSize="12.5"
                                          ContentPadding="10,0" IconGap="8,0,0,0"
                                          PlaceholderText="Filter by name or PID"
                                          ClearToolTip="Clear filter"
                                          Text="{Binding FilterText, Mode=TwoWay}"
                                          Completion="{Binding FilterCompletion}"
                                          ClearCommand="{Binding ClearFilterCommand}"/>

                    <Button DockPanel.Dock="Right" Classes="action" Content="Properties"
                            Margin="8,0,0,0" Click="OnPropertiesClick"
                            IsEnabled="{Binding HasSelection}"/>
                    <Button DockPanel.Dock="Right" Classes="endTask" Content="End task"
                            Command="{Binding RequestEndTaskCommand}"
                            IsEnabled="{Binding HasSelection}"/>
                    <TextBlock DockPanel.Dock="Right" Classes="cardSub" VerticalAlignment="Center"
                               Margin="12,0" Text="{Binding SelectionText}"
                               IsVisible="{Binding HasSelection}"/>
                    <TextBlock DockPanel.Dock="Right" Classes="cardSub" VerticalAlignment="Center"
                               TextAlignment="Right" TextWrapping="Wrap"
                               Foreground="{StaticResource Orange}" Text="{Binding ActionMessage}"
                               IsVisible="{Binding ActionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </DockPanel>
            </Border>

            <!-- Header + rows share one horizontal scroller, so a window too narrow for every
                 column scrolls sideways instead of dropping columns, and the header always stays over
                 the cells it labels. The inner grid's MinWidth is the width at which the weighted
                 split still clears every column's minimum; below that the scrollbar appears.
                 VerticalScrollBarVisibility is Disabled here so this viewer only measures width — the
                 rows keep their own vertical ScrollViewer inside it, which is what keeps the header
                 fixed while the list scrolls. -->
            <ScrollViewer Grid.Row="1" x:Name="TableScroll" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
            <!-- Width is pinned to the viewport rather than left to the content: a horizontal scroller
                 measures its child with infinite width, and a TextTrimming cell reports its FULL text
                 width there, so one long process name would widen the table past the window and leave
                 the scrollbar up for good. MinWidth then takes over once the window is narrower than
                 the columns need. -->
            <Grid RowDefinitions="Auto,*" MinWidth="{x:Static vm:ProcessTableLayout.MinTableWidth}"
                  Width="{Binding #TableScroll.Viewport.Width}">

            <!-- Sticky column header: each cell sorts by its column. Left columns put the arrow after
                 the label; right-aligned numeric columns put it before, so it always sits inward.
                 The extra 14px of right padding (16→30) reserves the row list's vertical-scrollbar
                 gutter so the header's star columns compute over the same width as the rows and stay
                 aligned with them (the gutter pattern from the Network table). -->
            <Border Grid.Row="0" Padding="16,8,30,8" BorderBrush="{DynamicResource Hairline}"
                    BorderThickness="0,0,0,1" Background="{DynamicResource CardBackground}">
                <!-- Named so the code-behind can hook the column drag; the cells inside are buttons, so
                     the drag has to tunnel past them. -->
                <Grid x:Name="HeaderColumns" ColumnSpacing="4"
                      layout:GridColumns.Definitions="{Binding ColumnLayout}">
                    <controls:SortableColumnHeader Grid.Column="{Binding NameColumn}" Text="NAME" Column="{Binding NameSort}"/>
                    <controls:SortableColumnHeader Grid.Column="{Binding PidColumn}" Text="PID" Column="{Binding PidSort}"/>
                    <controls:SortableColumnHeader Grid.Column="{Binding StatusColumn}" Text="STATUS" Column="{Binding StatusSort}"/>
                    <controls:SortableColumnHeader Grid.Column="{Binding CpuColumn}" Text="CPU" Column="{Binding CpuSort}"
                                                   ContentAlignment="Right" ArrowFirst="True"/>
                    <controls:SortableColumnHeader Grid.Column="{Binding MemoryColumn}" Text="MEMORY" Column="{Binding MemorySort}"
                                                   ContentAlignment="Right" ArrowFirst="True"/>
                    <controls:SortableColumnHeader Grid.Column="{Binding DiskColumn}" Text="DISK" Column="{Binding DiskSort}"
                                                   ContentAlignment="Right" ArrowFirst="True"/>
                    <controls:SortableColumnHeader Grid.Column="{Binding GpuColumn}" Text="GPU" Column="{Binding GpuSort}"
                                                   ContentAlignment="Right" ArrowFirst="True"/>
                </Grid>
            </Border>

            <!-- Scrolling grouped list -->
            <ScrollViewer Grid.Row="1" x:Name="ProcessListScroll"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Apps -->
                    <Border Classes="groupHead">
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="bare checkBox" Click="OnGroupCheckClick"
                                    Classes.on="{Binding AppsAllSelected}"
                                    Classes.some="{Binding AppsSomeSelected}"
                                    Tag="{x:Static vm:ProcessCategory.App}"
                                    ToolTip.Tip="Select every process in this group">
                                <Border>
                                    <!-- Both glyphs are laid on one Panel; exactly one is ever visible. -->
                                    <Panel>
                                        <TextBlock Text="✓" IsVisible="{Binding AppsAllSelected}"/>
                                        <TextBlock Text="–" IsVisible="{Binding AppsSomeSelected}"/>
                                    </Panel>
                                </Border>
                            </Button>
                            <TextBlock Text="{Binding AppsHeader}"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Apps}"
                                  ItemTemplate="{StaticResource ProcRowTemplate}"/>

                    <!-- Background -->
                    <Border Classes="groupHead">
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="bare checkBox" Click="OnGroupCheckClick"
                                    Classes.on="{Binding BackgroundAllSelected}"
                                    Classes.some="{Binding BackgroundSomeSelected}"
                                    Tag="{x:Static vm:ProcessCategory.Background}"
                                    ToolTip.Tip="Select every process in this group">
                                <Border>
                                    <!-- Both glyphs are laid on one Panel; exactly one is ever visible. -->
                                    <Panel>
                                        <TextBlock Text="✓" IsVisible="{Binding BackgroundAllSelected}"/>
                                        <TextBlock Text="–" IsVisible="{Binding BackgroundSomeSelected}"/>
                                    </Panel>
                                </Border>
                            </Button>
                            <TextBlock Text="{Binding BackgroundHeader}"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Background}"
                                  ItemTemplate="{StaticResource ProcRowTemplate}"/>

                    <!-- Windows processes -->
                    <Border Classes="groupHead">
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="bare checkBox" Click="OnGroupCheckClick"
                                    Classes.on="{Binding WindowsAllSelected}"
                                    Classes.some="{Binding WindowsSomeSelected}"
                                    Tag="{x:Static vm:ProcessCategory.Windows}"
                                    ToolTip.Tip="Select every process in this group">
                                <Border>
                                    <!-- Both glyphs are laid on one Panel; exactly one is ever visible. -->
                                    <Panel>
                                        <TextBlock Text="✓" IsVisible="{Binding WindowsAllSelected}"/>
                                        <TextBlock Text="–" IsVisible="{Binding WindowsSomeSelected}"/>
                                    </Panel>
                                </Border>
                            </Button>
                            <TextBlock Text="{Binding WindowsHeader}"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding WindowsProcesses}"
                                  ItemTemplate="{StaticResource ProcRowTemplate}"/>
                </StackPanel>
            </ScrollViewer>

            </Grid>
            </ScrollViewer>
        </Grid>
        </Border>

        <!-- End-task confirmation overlay: a scrim + centred card, covering the page while open.
             Ending a process is destructive, so it needs an explicit confirm. -->
        <Panel Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding ConfirmVisible}">
            <Border Background="#99000000"/>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                    Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Hairline}"
                    BorderThickness="1" CornerRadius="10" Padding="22"
                    BoxShadow="0 12 40 0 #55000000">
                <StackPanel Spacing="14">
                    <TextBlock Text="End task" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextStrong}"/>
                    <TextBlock Text="{Binding ConfirmText}" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="action" Content="Cancel" Command="{Binding CancelEndTaskCommand}"/>
                        <Button Classes="endTask" Content="End task" Command="{Binding ConfirmEndTaskCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</UserControl>
