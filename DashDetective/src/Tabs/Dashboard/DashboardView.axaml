<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:DashDetective.Shared.Controls"
             xmlns:layout="using:DashDetective.Shared.Layout"
             xmlns:vm="using:DashDetective.Tabs.Dashboard"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="920"
             x:DataType="vm:DashboardViewModel"
             x:Class="DashDetective.Tabs.Dashboard.DashboardView">

    <UserControl.Styles>
        <!-- Each stat card's accent brush is picked by its category class, keeping the dot + sparkline
             theme/accent-aware (as the fixed per-card bindings did before the row became collection-bound). -->
        <Style Selector="controls|StatCard.cpu"><Setter Property="Accent" Value="{DynamicResource ChartCpu}"/></Style>
        <Style Selector="controls|StatCard.mem"><Setter Property="Accent" Value="{DynamicResource ChartMemory}"/></Style>
        <Style Selector="controls|StatCard.gpu"><Setter Property="Accent" Value="{DynamicResource ChartGpu}"/></Style>
        <Style Selector="controls|StatCard.disk"><Setter Property="Accent" Value="{DynamicResource ChartStorage}"/></Style>
        <Style Selector="controls|StatCard.net"><Setter Property="Accent" Value="{DynamicResource ChartNetDown}"/></Style>
    </UserControl.Styles>

    <!-- Surfaces/typography come from src/Shared/Styles; StatCard / Sparkline / InfoRow come from
         src/Shared/Controls. -->
    <!-- One board for the whole page rather than a stack of fixed rows: that is what lets a wide
         window buy another column instead of stretching every panel, and what will let a widget be
         dragged from one row to another. -->
    <layout:WidgetBoard ColumnSpacing="{StaticResource SpacePage}" RowSpacing="{StaticResource SpacePage}" Order="{Binding WidgetOrder, Mode=TwoWay}">

        <!-- ===== Stat cards: one per detected device, grouped by kind (CPUs → Memory → GPUs → Disks
             → Network). As many per row as fit at 150px each — the width at which the label, value
             and sparkline stay legible — wrapping to further rows below that. No column cap, so on a
             wide window every device sits on one line instead of stranding the last card alone. -->
        <ItemsControl ItemsSource="{Binding Cards}" layout:WidgetBoard.Stretch="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <layout:UniformFlowPanel MinItemWidth="150" ColumnSpacing="12" RowSpacing="12"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DashboardCard">
                    <controls:StatCard Classes.cpu="{Binding IsCpu}" Classes.mem="{Binding IsMemory}"
                                       Classes.gpu="{Binding IsGpu}" Classes.disk="{Binding IsDisk}"
                                       Classes.net="{Binding IsNetwork}"
                                       Label="{Binding Label}" Value="{Binding Value}" Unit="{Binding Unit}"
                                       Sub="{Binding Sub}" YMin="0" YMax="100" Points="{Binding Points}"
                                       AxisMaxLabel="{Binding AxisMaxLabel}" AxisMinLabel="0"
                                       ToolTip.Tip="{Binding NoteTip}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Utilization charts. Capped at 760: past that a 60-second trace is just a long
             flat line, and the width is better spent on another column. -->
            <controls:WidgetPanel WidgetId="dashboard.cpu" MinWidth="340" layout:WidgetBoard.MaxSlotWidth="760"
                                  Title="CPU Utilization" Subtitle="{Binding CpuChartCaption}">
                <controls:WidgetPanel.HeaderContent>
                    <TextBlock Text="{Binding CpuPercentText}" FontSize="12" Foreground="{DynamicResource ChartCpu}"/>
                </controls:WidgetPanel.HeaderContent>
                <controls:Sparkline Classes="chartPanel" Fill="True" ShowGrid="True" Stroke="{DynamicResource ChartCpu}"
                                    YMin="0" YMax="100" Points="{Binding CpuPoints}"
                                    AxisMaxLabel="100%" AxisMidLabel="50%" AxisMinLabel="0"
                                    AxisStartLabel="{Binding ChartRangeStart}" AxisEndLabel="now"
                                    StatusText="{Binding CpuChartStatus}"/>
            </controls:WidgetPanel>
            <controls:WidgetPanel WidgetId="dashboard.memory" MinWidth="340" layout:WidgetBoard.MaxSlotWidth="760"
                                  Title="Memory Utilization" Subtitle="{Binding MemoryChartCaption}">
                <controls:WidgetPanel.HeaderContent>
                    <TextBlock Text="{Binding MemoryUtilizationText}" FontSize="12" Foreground="{DynamicResource ChartMemory}"/>
                </controls:WidgetPanel.HeaderContent>
                <controls:Sparkline Classes="chartPanel" Fill="True" ShowGrid="True" Stroke="{DynamicResource ChartMemory}"
                                    YMin="0" YMax="100" Points="{Binding MemoryPoints}"
                                    AxisMaxLabel="100%" AxisMidLabel="50%" AxisMinLabel="0"
                                    AxisStartLabel="{Binding ChartRangeStart}" AxisEndLabel="now"
                                    StatusText="{Binding MemoryChartStatus}"/>
            </controls:WidgetPanel>

            <!-- ===== System info + Network throughput. System info keeps the wider share of whatever
                 row it lands in; its two columns of key/value rows stop reading as a pair much past
                 860, so that is its ceiling. -->
            <controls:WidgetPanel layout:WidgetBoard.Weight="1.35" MinWidth="420"
                                  layout:WidgetBoard.MaxSlotWidth="860"
                                  WidgetId="dashboard.system" Title="System Information">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                        <StackPanel Grid.Column="0">
                            <controls:InfoRow Key="OS" Value="{Binding OsText}"/>
                            <controls:InfoRow Key="Device" Value="{Binding DeviceText}"/>
                            <controls:InfoRow Key="Cores" Value="{Binding CpuCoresText}"/>
                            <controls:InfoRow Key="GPU" Value="{Binding GpuModelText}"/>
                            <controls:InfoRow Key="BIOS" Value="{Binding BiosText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <controls:InfoRow Key="Build" Value="{Binding BuildText}"/>
                            <controls:InfoRow Key="CPU" Value="{Binding CpuModelText}"/>
                            <controls:InfoRow Key="RAM" Value="{Binding MemoryModelText}"/>
                            <controls:InfoRow Key="Uptime" Value="{Binding UptimeText}"/>
                            <controls:InfoRow Key="Motherboard" Value="{Binding MotherboardText}"/>
                        </StackPanel>
                    </Grid>
            </controls:WidgetPanel>

            <controls:WidgetPanel WidgetId="dashboard.network" MinWidth="300"
                                  layout:WidgetBoard.MaxSlotWidth="700" Title="Network Throughput">
                <controls:WidgetPanel.HeaderContent>
                    <TextBlock Text="{Binding NetworkAdapterName}" FontSize="11" Foreground="{DynamicResource TextSubtle}"/>
                </controls:WidgetPanel.HeaderContent>
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Spacing="1">
                            <TextBlock Text="↓ Download" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding NetworkDownText}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ChartNetDown}"/>
                                <TextBlock Text="{Binding NetworkDownUnit}" FontSize="11" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="1">
                            <TextBlock Text="↑ Upload" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding NetworkUpText}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ChartNetUp}"/>
                                <TextBlock Text="{Binding NetworkUpUnit}" FontSize="11" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <!-- Two series on one axis, so the key is not optional: without it the orange and blue
                         lines are unexplained. The value labels are live because the ceiling follows the
                         traffic; the percentage charts above can state theirs as literals. -->
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Trims: the caption carries the adapter NAME, which runs long on a virtual or
                             filter adapter, and an untrimmed TextBlock overflows its column into the key. -->
                        <TextBlock Grid.Column="0" Classes="cardSub" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding NetworkChartCaption}"/>
                        <controls:ChartLegend Grid.Column="1"
                                              Label1="Download" Brush1="{DynamicResource ChartNetDown}"
                                              Label2="Upload" Brush2="{DynamicResource ChartNetUp}"/>
                    </Grid>
                    <controls:Sparkline Classes="chartPanel" Fill="True" ShowGrid="True"
                                        Stroke="{DynamicResource ChartNetDown}" Points="{Binding NetworkDownPoints}"
                                        Stroke2="{DynamicResource ChartNetUp}" Points2="{Binding NetworkUpPoints}"
                                        YMin="0" YMax="100"
                                        AxisMaxLabel="{Binding NetworkAxisMax}" AxisMidLabel="{Binding NetworkAxisMid}"
                                        AxisMinLabel="0"
                                        AxisStartLabel="{Binding ChartRangeStart}" AxisEndLabel="now"
                                        StatusText="{Binding NetworkChartStatus}"/>
                </StackPanel>
            </controls:WidgetPanel>
    </layout:WidgetBoard>
</UserControl>
