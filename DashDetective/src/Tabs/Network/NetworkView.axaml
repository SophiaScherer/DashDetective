<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:DashDetective.Shared.Controls"
             xmlns:layout="using:DashDetective.Shared.Layout"
             xmlns:vm="using:DashDetective.Tabs.Network"
             xmlns:sys="using:System"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="720"
             x:DataType="vm:NetworkViewModel"
             x:Class="DashDetective.Tabs.Network.NetworkView">

    <!-- The design comp's Network page: six panels in two rows (Adapters · IP Configuration ·
         Throughput / Active Connections · Ping · DNS Lookup). Surfaces/typography come from
         src/Shared/Styles; the throughput charts reuse the shared Sparkline. -->
    <!-- MonoFont and the Console* tokens come from src/Shared/Styles/Palette.axaml: the Toolkit tab
         draws the same terminal surface, so they are app-level rather than declared here. Mono is used
         for IP/address values that read better column-aligned (IP config, connection endpoints, and
         the ping/DNS console output). -->
    <UserControl.Resources>
        <!-- The connections table's columns, declared once and applied to both the header row and the
             row template through GridColumns.Definitions, so the two cannot drift apart. -->
        <sys:String x:Key="ConnectionColumns">1.2*,1.4*,*,Auto</sys:String>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- One IP Configuration key/value row: muted key on the left, monospace value on the right. -->
        <Style Selector="TextBlock.ipKey">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.ipVal">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- TextBlock.colHead and Border.field are shared (src/Shared/Styles/SharedStyles.axaml); the
             connections table and the Ping/DNS targets use them as-is. Button.go stays here: it is the
             field's submit partner and no other tab has one. Its height tracks Border.field. -->
        <Style Selector="Button.go">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.go:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlayStrong}"/>
        </Style>
        <!-- Google-style pager: page-number / arrow buttons, with the current page accented and
             ellipsis / end-arrows dimmed via the disabled state. -->
        <!-- Reveal flash for an adapter arrived at from the Performance tab. The transition sits directly
             on the row: it carries no :pointerover, so there is nothing for a hover to smear. -->
        <Style Selector="Border.adapterRow">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.4"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.adapterRow.highlighted">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>

        <Style Selector="Button.pageLink">
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.pageLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        </Style>
        <Style Selector="Button.pageLink.selected">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="16">

        <!-- ===== Row 1: Adapters · IP Configuration · Throughput. Three across while each clears
             its minimum, then stacked full width. -->
        <layout:WeightedRowPanel ColumnSpacing="16" RowSpacing="16">
            <Border Classes="panel" MinWidth="260">
                <StackPanel Spacing="8">
                    <TextBlock Classes="panelTitle" Text="Adapters"/>
                    <!-- Cap the list to ~the IP Configuration card's height and scroll the overflow, so
                         a machine with many adapters doesn't push the rest of the page off-screen. -->
                    <ScrollViewer MaxHeight="188"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Adapters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AdapterInfo">
                                    <!-- Right padding reserves a gutter so the vertical scrollbar sits
                                         beside the row content (link speed) rather than over it. -->
                                    <!-- Tag carries the adapter name so a reveal from the Performance tab
                                         can find this row without a parallel list here. -->
                                    <Border Classes="adapterRow" Tag="{Binding Name}"
                                            BorderBrush="{DynamicResource RowLine}"
                                            BorderThickness="0,0,0,1" Padding="0,9,14,9">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                                                     Fill="{Binding DotBrush}"/>
                                            <StackPanel Grid.Column="1" Margin="11,0,8,0" Spacing="1">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="{DynamicResource TextSubtle}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" TextAlignment="Right"
                                                           Foreground="{Binding StatusBrush}"/>
                                                <TextBlock Text="{Binding SpeedText}" FontSize="11" TextAlignment="Right"
                                                           Foreground="{DynamicResource TextSubtle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
            <Border Classes="panel" MinWidth="260">
                <StackPanel Spacing="12">
                    <TextBlock Classes="panelTitle" Text="IP Configuration"/>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="ipKey" Text="IPv4 Address"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="ipVal" Text="{Binding IpConfig.Ipv4}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="ipKey" Text="Subnet Mask"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="ipVal" Text="{Binding IpConfig.SubnetMask}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="ipKey" Text="Gateway"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="ipVal" Text="{Binding IpConfig.Gateway}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="ipKey" Text="DNS"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="ipVal" Text="{Binding IpConfig.Dns}"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="ipKey" Text="MAC"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Classes="ipVal" Text="{Binding IpConfig.Mac}"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Classes="ipKey" Text="DHCP"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Classes="ipVal" Text="{Binding IpConfig.Dhcp}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border layout:WeightedRowPanel.Weight="1.1" Classes="panel" MinWidth="280">
                <StackPanel Spacing="10">
                    <TextBlock Classes="panelTitle" Text="Throughput"/>
                    <!-- Both charts share one Y axis (ThroughputYMax), so their heights must match too:
                         equal Mbps must map to equal pixels for the comparison to be honest. The peak
                         caption on the right makes the shared ceiling legible. -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="18">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                <TextBlock Text="↓" FontSize="12" Foreground="{DynamicResource ChartNetDown}"/>
                                <TextBlock Text="{Binding DownText}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Text="{Binding DownUnit}" FontSize="12" Foreground="{DynamicResource TextSubtle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                <TextBlock Text="↑" FontSize="12" Foreground="{DynamicResource ChartNetUp}"/>
                                <TextBlock Text="{Binding UpText}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Text="{Binding UpUnit}" FontSize="12" Foreground="{DynamicResource TextSubtle}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ThroughputScaleText}" FontSize="11"
                                   VerticalAlignment="Bottom" Foreground="{DynamicResource TextSubtle}"/>
                    </Grid>
                    <TextBlock Classes="cardSub" Text="{Binding ThroughputChartCaption}"/>
                    <!-- One series each, so each is keyed above its own trace rather than by a shared
                         legend — with two stacked charts, naming which is which beats naming both at once.
                         Both carry the same value labels, which is what keeps their gutters equal and so
                         their plots the same width: on a shared ceiling, equal Mbps has to mean equal
                         pixels. The time range goes under the lower one only — the pair reads as a single
                         span, and repeating it would say so twice. -->
                    <StackPanel Spacing="2">
                        <controls:ChartLegend Label1="Download" Brush1="{DynamicResource ChartNetDown}"/>
                        <controls:Sparkline Classes="chartMini" Fill="True" ShowGrid="True"
                                            Stroke="{DynamicResource ChartNetDown}" Points="{Binding DownPoints}"
                                            YMin="0" YMax="100"
                                            AxisMaxLabel="{Binding ThroughputAxisMax}"
                                            AxisMidLabel="{Binding ThroughputAxisMid}" AxisMinLabel="0"
                                            StatusText="{Binding ThroughputChartStatus}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <controls:ChartLegend Label1="Upload" Brush1="{DynamicResource ChartNetUp}"/>
                        <controls:Sparkline Classes="chartMini" Fill="True" ShowGrid="True"
                                            Stroke="{DynamicResource ChartNetUp}" Points="{Binding UpPoints}"
                                            YMin="0" YMax="100"
                                            AxisMaxLabel="{Binding ThroughputAxisMax}"
                                            AxisMidLabel="{Binding ThroughputAxisMid}" AxisMinLabel="0"
                                            AxisStartLabel="{Binding ChartRangeStart}" AxisEndLabel="now"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </layout:WeightedRowPanel>

        <!-- ===== Row 2: Active Connections · (Ping + DNS). The connections table keeps the wider
             share; below their minimums the two stack. -->
        <layout:WeightedRowPanel ColumnSpacing="16" RowSpacing="16">
            <Border layout:WeightedRowPanel.Weight="1.6" Classes="panel" MinWidth="420">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="panelTitle" Text="Active Connections"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ConnectionsSummary}" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSubtle}"/>
                    </Grid>
                    <!-- Column header. The 14px right margin matches the rows' gutter below so the columns
                         stay aligned and the scrollbar sits in the shared gutter, not over the text. -->
                    <Grid layout:GridColumns.Definitions="{StaticResource ConnectionColumns}" Margin="0,0,14,2">
                        <TextBlock Grid.Column="0" Classes="colHead" Text="PROCESS"/>
                        <TextBlock Grid.Column="1" Classes="colHead" Text="REMOTE ADDRESS"/>
                        <TextBlock Grid.Column="2" Classes="colHead" Text="STATE"/>
                        <TextBlock Grid.Column="3" Classes="colHead" Text="PROTOCOL" TextAlignment="Right"/>
                    </Grid>
                    <!-- Whole page scrolls, so bound the table's own scroller or it never engages. Kept
                         compact enough that the panel + pager stay on-screen in the default (non-maximized)
                         window rather than pushing the pager below the fold. -->
                    <ScrollViewer x:Name="ConnectionsScroller" MaxHeight="240"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Connections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConnectionRow">
                                    <Grid layout:GridColumns.Definitions="{StaticResource ConnectionColumns}" Height="30" Margin="0,0,14,0">
                                        <TextBlock Grid.Column="0" Text="{Binding Process}" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RemoteEndpoint}" FontSize="11.5"
                                                   FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSubtle}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="11.5"
                                                   VerticalAlignment="Center" Foreground="{Binding StateBrush}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Protocol}" FontSize="11.5"
                                                   VerticalAlignment="Center" TextAlignment="Right"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- Pager (Prev · 1 … 4 5 6 … 20 · Next); only visible when there's >1 page. -->
                    <ItemsControl ItemsSource="{Binding PageLinks}" IsVisible="{Binding PagerVisible}"
                                  HorizontalAlignment="Center" Margin="0,2,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageLink">
                                <Button Classes="pageLink" Classes.selected="{Binding IsCurrent}"
                                        Content="{Binding Label}" Command="{Binding SelectCommand}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <StackPanel Spacing="12" MinWidth="260">
                <!-- Editable target, seeded with this machine's own gateway. The monitor is opt-in: the
                     button starts and stops it, and Enter applies the target and starts. Nothing here
                     sends a packet until it is pressed — which is why Enter and the button differ. -->
                <vm:ConsolePanel Title="Ping"
                                  Target="{Binding PingTarget, Mode=TwoWay}"
                                  Placeholder="Host or IP to ping"
                                  ButtonText="{Binding PingButtonText}"
                                  SubmitCommand="{Binding TogglePingCommand}"
                                  EnterCommand="{Binding ApplyPingTargetCommand}"
                                  ConsoleText="{Binding PingConsole}"
                                  ConsoleBrush="{StaticResource ConsoleGreen}"
                                  FooterText="{Binding PingSummary}"
                                  FooterBrush="{StaticResource ConsoleMuted}"/>

                <!-- Editable host: Enter or the button re-resolves it, so both run the same command. -->
                <vm:ConsolePanel Title="DNS Lookup"
                                  Target="{Binding DnsHost, Mode=TwoWay}"
                                  Placeholder="Host name to resolve"
                                  ButtonText="Look up"
                                  SubmitCommand="{Binding LookupDnsCommand}"
                                  EnterCommand="{Binding LookupDnsCommand}"
                                  ConsoleText="{Binding DnsConsole}"
                                  ConsoleBrush="{StaticResource ConsoleFg}"
                                  FooterText="{Binding DnsFooter}"
                                  FooterBrush="{StaticResource ConsoleBlue}"/>
            </StackPanel>
        </layout:WeightedRowPanel>
    </StackPanel>
</UserControl>
