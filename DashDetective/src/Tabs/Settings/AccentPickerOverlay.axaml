<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:DashDetective.Tabs.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
             x:Class="DashDetective.Tabs.Settings.AccentPickerOverlay"
             x:DataType="settings:AccentPickerViewModel"
             IsVisible="{Binding IsOpen}">

    <!-- The accent picker modal, on the Help overlay's shape: a scrim that swallows input and a centred
         card. Hosted by the shell beside Help so it dims the nav bar too. The strips render the draft
         through AccentPreviewScope; nothing reaches the app until Apply. -->
    <Border x:Name="Scrim" Background="{StaticResource ScrimBackground}" PointerPressed="OnScrimPointerPressed">

        <!-- The margin keeps the card inside a short window, where the body scrolls rather than pushing
             the header and footer off screen. Tab cycles within the card, so focus cannot reach the page
             behind the scrim. -->
        <Border x:Name="Card" Classes="panel" Padding="0" Margin="24"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BoxShadow="{StaticResource ShadowModal}" KeyboardNavigation.TabNavigation="Cycle">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1"
                        Padding="22,18">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Accent color" FontSize="{DynamicResource TextSizeHeading}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextStrong}"/>
                            <TextBlock Text="Preview a color in both themes before applying it"
                                       FontSize="{DynamicResource TextSizeSmall}" Foreground="{DynamicResource TextSubtle}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="modalClose" ToolTip.Tip="Close"
                                Command="{Binding CancelCommand}">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeLineCap="Round" Data="M1,1 L11,11 M11,1 L1,11"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body: the picker, then both previews. The inset is the content's Margin: a ScrollViewer
                     leaves its own Padding out of the scroll extent. -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="24" Margin="22,20">
                    <StackPanel Grid.Column="0" Width="200" Spacing="10">
                        <settings:ColorWheel x:Name="Wheel" Width="200" Height="200"
                                             Hue="{Binding Hue}" Saturation="{Binding Saturation}"
                                             Brightness="{Binding Brightness}"
                                             AutomationProperties.Name="Accent hue and saturation"/>
                        <settings:BrightnessBar Hue="{Binding Hue}" Saturation="{Binding Saturation}"
                                                Brightness="{Binding Brightness}"
                                                AutomationProperties.Name="Accent brightness"/>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Border Grid.Column="0" Classes="field" Width="96">
                                <TextBox Classes="flat" Text="{Binding HexText}" MaxLength="7"
                                         AutomationProperties.Name="Accent hex color"
                                         LostFocus="OnHexLostFocus" KeyDown="OnHexKeyDown"/>
                            </Border>
                            <!-- Before and after: what the app uses now, beside the draft. -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        ToolTip.Tip="Current and new accent">
                                <Border Classes="swatch" Background="{Binding AppliedBrush}"/>
                                <TextBlock Text="→" Foreground="{DynamicResource TextSubtle}"
                                           FontSize="{DynamicResource TextSizeSmall}" VerticalAlignment="Center"/>
                                <Border Classes="swatch" Background="{Binding DraftBrush}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Warning}" IsVisible="{Binding HasWarning}"
                                   Foreground="{DynamicResource StatusWarnText}"
                                   FontSize="{DynamicResource TextSizeSmall}" TextWrapping="Wrap"/>
                        <Button Classes="link" Content="Revert to default" HorizontalAlignment="Left"
                                Command="{Binding RevertToDefaultCommand}" IsEnabled="{Binding CanRevert}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Dark" FontSize="{DynamicResource TextSizeSmall}" Foreground="{DynamicResource TextSubtle}"/>
                        <settings:AccentPreviewScope RequestedThemeVariant="{Binding DarkVariant}" Accent="{Binding Draft}">
                            <settings:AccentPreview AutomationProperties.Name="Accent preview, dark theme"/>
                        </settings:AccentPreviewScope>
                        <TextBlock Text="Light" Margin="0,6,0,0" FontSize="{DynamicResource TextSizeSmall}"
                                   Foreground="{DynamicResource TextSubtle}"/>
                        <settings:AccentPreviewScope RequestedThemeVariant="{Binding LightVariant}" Accent="{Binding Draft}">
                            <settings:AccentPreview AutomationProperties.Name="Accent preview, light theme"/>
                        </settings:AccentPreviewScope>
                    </StackPanel>
                </Grid>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="22,14">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="action" Content="Cancel" Command="{Binding CancelCommand}"/>
                        <Button Classes="action primary" Content="Apply" Command="{Binding ApplyCommand}"
                                IsEnabled="{Binding IsDirty}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
