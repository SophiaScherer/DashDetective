<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DashDetective.Tabs.Settings.ShortcutCaptureBox">

    <UserControl.Styles>
        <!-- Armed, the box is an accent-outlined prompt rather than a value: it is asking for input, not
             showing one. -->
        <Style Selector="Border#Box.capturing">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Border#Box.capturing TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Name="Trigger" Classes="bare" Focusable="True">
            <Border Name="Box" Classes="field" MinWidth="132" Padding="10,0">
                <TextBlock Name="Label" FontSize="{DynamicResource TextSizeCompact}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Button>

        <!-- Cancel and Reset share one slot that is always reserved, so the box never moves under the pointer
             as either appears, and every row's box lines up whether or not its binding is custom. -->
        <Panel MinWidth="{Binding #Cancel.Width}">
            <!-- Shown only while armed. Not focusable: pressing it must not take focus from the box first,
                 which would stand the capture down through LostFocus and hide this button mid-click. -->
            <Button Name="Cancel" Classes="toolIcon" IsVisible="False" Focusable="False" ToolTip.Tip="Cancel (Esc)">
                <Path Width="11" Height="11" Stretch="None" Stroke="{DynamicResource TextTertiary}"
                      StrokeThickness="1.5" StrokeLineCap="Round" Data="M1,1 L10,10 M10,1 L1,10"/>
            </Button>

            <!-- Only offered once there is something to undo. -->
            <Button Name="Reset" Classes="toolIcon" IsVisible="False" ToolTip.Tip="Restore the default">
                <Path Width="14" Height="14" Stretch="None" Stroke="{DynamicResource TextTertiary}"
                      StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                      Data="M3,7 A4,4 0 1 1 4.2,9.9 M3,4 V7 H6"/>
            </Button>
        </Panel>
        <!-- Only offered once there is something to undo, so an untouched row carries no extra chrome. -->
        <Button Name="Reset" Classes="toolIcon" IsVisible="False" ToolTip.Tip="Restore the default">
            <Path Width="{StaticResource IconSize}" Height="{StaticResource IconSize}" Stretch="Uniform" Stroke="{DynamicResource TextTertiary}"
                  StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                  Data="M3,7 A4,4 0 1 1 4.2,9.9 M3,4 V7 H6"/>
        </Button>
    </StackPanel>
</UserControl>
