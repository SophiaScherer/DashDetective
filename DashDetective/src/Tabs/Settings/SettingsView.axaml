<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:DashDetective.Shared.Controls"
             xmlns:settings="using:DashDetective.Tabs.Settings"
             xmlns:nav="using:DashDetective.Shell.Navigation"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="720"
             x:DataType="settings:SettingsViewModel"
             x:Class="DashDetective.Tabs.Settings.SettingsView">

    <!-- Every section is live and wired to SettingsViewModel: Appearance (Theme + Accent via the
         ThemeService), Navigation (the shared NavigationViewModel), Monitoring (refresh interval,
         resource-alert / tray / startup toggles) and Export & Data (report / CSV / clipboard, handled
         in the code-behind, which owns the save dialog + clipboard). Choices persist via the settings
         store. Surfaces, segments, toggles and buttons are styled from src/Shared/Styles. -->
    <UserControl.Styles>
        <!-- Both trim. Each row is a star column beside an Auto control, so the text column shrinks as the
             window narrows, and an untrimmed TextBlock overflows its column instead of clipping to it —
             the description drew straight under the segmented control at the window's minimum. -->
        <Style Selector="TextBlock.settingName">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.settingDesc">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- One row per setting. Each carries its SettingId as its Tag, which is how a jump from
             universal search finds the row to scroll to (see the code-behind) without the page needing
             a name for every control. The reveal tint and its fade come from the shared
             Border.revealFlash, which every row also carries. This style must NOT set Background:
             Avalonia ranks styles by how close their host is to the control, so a Background here — even
             Transparent — outranks the app-level .highlighted rule and the flash never shows. -->
        <Style Selector="Border.settingRow">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusField}"/>
        </Style>
        <!-- A setting this platform cannot honour. The whole row dims, not just its control: a disabled
             toggle alone is indistinguishable from one that is merely off. -->
        <Style Selector="Border.settingRow:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- The chrome-less button wrapper that makes a whole segment / swatch clickable is the shared
             Button.bare (src/Shared/Styles/SharedStyles.axaml). -->

        <!-- Accent swatch + its selection ring. ClipToBounds so the four-colour legend of the
             default option is clipped to the rounded corners. -->
        <Style Selector="Border.swatch">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="Border.swatch.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource TextStrong}"/>
        </Style>
    </UserControl.Styles>

    <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="16">

        <!-- ===== Appearance ===== -->
        <controls:WidgetPanel WidgetId="settings.appearance" Title="Appearance">
            <StackPanel Spacing="16">

                <Border Classes="settingRow revealFlash" Tag="{x:Static settings:SettingId.Theme}">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Classes="settingName" Text="{Binding Catalog.Theme.Name}"/>
                        <TextBlock Classes="settingDesc" Text="{Binding Catalog.Theme.Description}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Classes="segments">
                        <ItemsControl ItemsSource="{Binding ThemeOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="settings:ThemeOption">
                                    <Button Classes="bare" Command="{Binding SelectCommand}">
                                        <Border Classes="seg" Classes.selected="{Binding IsSelected}">
                                            <TextBlock Text="{Binding Label}"/>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
                </Border>

                <Border Classes="settingRow revealFlash" Tag="{x:Static settings:SettingId.Accent}">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Classes="settingName" Text="{Binding Catalog.Accent.Name}"/>
                        <TextBlock Classes="settingDesc" Text="{Binding Catalog.Accent.Description}"/>
                    </StackPanel>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding AccentOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="settings:AccentOption">
                                <Button Classes="bare" Command="{Binding SelectCommand}"
                                        ToolTip.Tip="{Binding Preset.Name, FallbackValue='Default'}">
                                    <Border Classes="swatch" Classes.selected="{Binding IsSelected}"
                                            Background="{Binding Swatch}">
                                        <!-- Four-colour legend, shown only for the Default option. -->
                                        <Grid IsVisible="{Binding IsDefault}"
                                              ColumnDefinitions="*,*" RowDefinitions="*,*">
                                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Blue}"/>
                                            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource Green}"/>
                                            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Purple}"/>
                                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Orange}"/>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                </Border>

                <Border Classes="settingRow revealFlash" Tag="{x:Static settings:SettingId.ClockFormat}">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Classes="settingName" Text="{Binding Catalog.ClockFormat.Name}"/>
                        <TextBlock Classes="settingDesc" Text="{Binding Catalog.ClockFormat.Description}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Classes="segments">
                        <ItemsControl ItemsSource="{Binding ClockFormatOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="settings:ClockFormatOption">
                                    <Button Classes="bare" Command="{Binding SelectCommand}">
                                        <Border Classes="seg" Classes.selected="{Binding IsSelected}">
                                            <TextBlock Text="{Binding Label}"/>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
                </Border>
            </StackPanel>
        </controls:WidgetPanel>

        <!-- ===== Navigation ===== -->
        <!-- These controls drive the shared NavigationViewModel, so they stay in sync with the bar's
             hover chevron, its right-click dock menu and the drag-to-dock gesture. -->
        <controls:WidgetPanel WidgetId="settings.navigation" Title="Navigation">
            <StackPanel Spacing="16">

                <Border Classes="settingRow revealFlash" Tag="{x:Static settings:SettingId.NavPosition}">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Classes="settingName" Text="{Binding Catalog.NavPosition.Name}"/>
                        <TextBlock Classes="settingDesc" Text="{Binding Catalog.NavPosition.Description}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Classes="segments">
                        <ItemsControl ItemsSource="{Binding Nav.Positions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="nav:NavPositionOption">
                                    <Button Classes="bare" Command="{Binding SelectCommand}">
                                        <Border Classes="seg" Classes.selected="{Binding IsSelected}">
                                            <TextBlock Text="{Binding Label}"/>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
                </Border>

                <Border Classes="settingRow revealFlash" Tag="{x:Static settings:SettingId.NavCollapse}"
                        BorderBrush="{DynamicResource RowLine}" BorderThickness="0,1,0,0" Padding="0,9,0,0">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Classes="settingName" Text="{Binding Catalog.NavCollapse.Name}"/>
                            <TextBlock Classes="settingDesc" Text="{Binding Catalog.NavCollapse.Description}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Classes="segments">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="bare" Command="{Binding Nav.ExpandCommand}">
                                    <Border Classes="seg" Classes.selected="{Binding !Nav.IsCollapsed}">
                                        <TextBlock Text="Expanded"/>
                                    </Border>
                                </Button>
                                <Button Classes="bare" Command="{Binding Nav.CollapseCommand}">
                                    <Border Classes="seg" Classes.selected="{Binding Nav.IsCollapsed}">
                                        <TextBlock Text="Icons only"/>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </controls:WidgetPanel>

        <!-- ===== Monitoring ===== -->
        <controls:WidgetPanel WidgetId="settings.monitoring" Title="Monitoring">
            <StackPanel Spacing="16">

                <Border Classes="settingRow revealFlash" Tag="{x:Static settings:SettingId.RefreshInterval}">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Classes="settingName" Text="{Binding Catalog.RefreshInterval.Name}"/>
                        <TextBlock Classes="settingDesc" Text="{Binding Catalog.RefreshInterval.Description}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Classes="segments">
                        <ItemsControl ItemsSource="{Binding IntervalOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="settings:IntervalOption">
                                    <Button Classes="bare" Command="{Binding SelectCommand}">
                                        <Border Classes="seg" Classes.selected="{Binding IsSelected}">
                                            <TextBlock Text="{Binding Label}"/>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
                </Border>

                <!-- Toggle rows. "Resource alerts" merges the comp's two notification toggles (there is
                     no OS toast in scope, so both described the same in-app threshold banner). -->
                <Border Classes="settingRow revealFlash" Tag="{x:Static settings:SettingId.ResourceAlerts}"
                        BorderBrush="{DynamicResource RowLine}" BorderThickness="0,1,0,0" Padding="0,9,0,0">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Classes="settingName" Text="{Binding Catalog.ResourceAlerts.Name}"/>
                            <TextBlock Classes="settingDesc" Text="{Binding Catalog.ResourceAlerts.Description}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Classes="toggle" IsChecked="{Binding ResourceAlerts}"/>
                    </Grid>
                </Border>

                <!-- Disabled rather than hidden where nothing has to be launched: the row stays in the
                     search index, and a preference carried between machines survives. -->
                <Border Classes="settingRow revealFlash" Tag="{x:Static settings:SettingId.NvidiaGpuMetrics}"
                        IsEnabled="{Binding CanUseNvidiaMetrics}"
                        BorderBrush="{DynamicResource RowLine}" BorderThickness="0,1,0,0" Padding="0,9,0,0">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Classes="settingName" Text="{Binding Catalog.NvidiaGpuMetrics.Name}"/>
                            <TextBlock Classes="settingDesc" Text="{Binding Catalog.NvidiaGpuMetrics.Description}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Classes="toggle" IsChecked="{Binding NvidiaGpuMetrics}"/>
                    </Grid>
                </Border>

                <Border Classes="settingRow revealFlash" Tag="{x:Static settings:SettingId.ShowInTray}"
                        IsEnabled="{Binding CanUseTray}"
                        BorderBrush="{DynamicResource RowLine}" BorderThickness="0,1,0,0" Padding="0,9,0,0">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Classes="settingName" Text="{Binding Catalog.ShowInTray.Name}"/>
                            <TextBlock Classes="settingDesc" Text="{Binding Catalog.ShowInTray.Description}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Classes="toggle" IsChecked="{Binding ShowInTray}"/>
                    </Grid>
                </Border>

                <Border Classes="settingRow revealFlash" Tag="{x:Static settings:SettingId.LaunchAtStartup}"
                        BorderBrush="{DynamicResource RowLine}" BorderThickness="0,1,0,0" Padding="0,9,0,0">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Classes="settingName" Text="{Binding Catalog.LaunchAtStartup.Name}"/>
                            <TextBlock Classes="settingDesc" Text="{Binding Catalog.LaunchAtStartup.Description}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Classes="toggle" IsChecked="{Binding LaunchAtStartup}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </controls:WidgetPanel>

        <!-- ===== Alerts ===== -->
        <!-- Its own card rather than six more Monitoring rows, and every row is gated on the master
             "Resource alerts" toggle above. Disabled on the whole Border, not just the control: a dimmed
             control reads as "not in effect", where a live one beside a dead toggle would not.

             A typed number rather than a run of preset segments: five or six presets per row pushed the
             description into a narrow column, and a threshold is a number people want to state. The
             per-row switch is what turns a resource off, so the number survives being switched off and
             the field never has to carry a magic "Off" member. "Warn after" has no switch — it is the
             wait before a warning, not a warning. -->
        <controls:WidgetPanel WidgetId="settings.alerts" Title="{Binding Catalog.AlertCpu.Section}"
                              Subtitle="Watched only while Resource alerts is on">
            <StackPanel Spacing="16">

                <Border Classes="settingRow revealFlash" Tag="{x:Static settings:SettingId.AlertCpu}"
                        IsEnabled="{Binding ResourceAlerts}">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                            <TextBlock Classes="settingName" Text="{Binding Catalog.AlertCpu.Name}"/>
                            <TextBlock Classes="settingDesc" Text="{Binding Catalog.AlertCpu.Description}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <settings:NumericField Value="{Binding CpuAlert.Value, Mode=TwoWay}"
                                                   Minimum="{Binding CpuAlert.Minimum}"
                                                   Maximum="{Binding CpuAlert.Maximum}"
                                                   Suffix="{Binding CpuAlert.Suffix}" IsEnabled="{Binding CpuAlert.IsEnabled}"/>
                            <ToggleButton Classes="toggle" IsChecked="{Binding CpuAlert.IsEnabled}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="settingRow revealFlash" Tag="{x:Static settings:SettingId.AlertMemory}"
                        IsEnabled="{Binding ResourceAlerts}"
                        BorderBrush="{DynamicResource RowLine}" BorderThickness="0,1,0,0" Padding="0,9,0,0">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                            <TextBlock Classes="settingName" Text="{Binding Catalog.AlertMemory.Name}"/>
                            <TextBlock Classes="settingDesc" Text="{Binding Catalog.AlertMemory.Description}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <settings:NumericField Value="{Binding MemoryAlert.Value, Mode=TwoWay}"
                                                   Minimum="{Binding MemoryAlert.Minimum}"
                                                   Maximum="{Binding MemoryAlert.Maximum}"
                                                   Suffix="{Binding MemoryAlert.Suffix}" IsEnabled="{Binding MemoryAlert.IsEnabled}"/>
                            <ToggleButton Classes="toggle" IsChecked="{Binding MemoryAlert.IsEnabled}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="settingRow revealFlash" Tag="{x:Static settings:SettingId.AlertGpu}"
                        IsEnabled="{Binding ResourceAlerts}"
                        BorderBrush="{DynamicResource RowLine}" BorderThickness="0,1,0,0" Padding="0,9,0,0">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                            <TextBlock Classes="settingName" Text="{Binding Catalog.AlertGpu.Name}"/>
                            <TextBlock Classes="settingDesc" Text="{Binding Catalog.AlertGpu.Description}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <settings:NumericField Value="{Binding GpuAlert.Value, Mode=TwoWay}"
                                                   Minimum="{Binding GpuAlert.Minimum}"
                                                   Maximum="{Binding GpuAlert.Maximum}"
                                                   Suffix="{Binding GpuAlert.Suffix}" IsEnabled="{Binding GpuAlert.IsEnabled}"/>
                            <ToggleButton Classes="toggle" IsChecked="{Binding GpuAlert.IsEnabled}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="settingRow revealFlash" Tag="{x:Static settings:SettingId.AlertDiskActivity}"
                        IsEnabled="{Binding ResourceAlerts}"
                        BorderBrush="{DynamicResource RowLine}" BorderThickness="0,1,0,0" Padding="0,9,0,0">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                            <TextBlock Classes="settingName" Text="{Binding Catalog.AlertDiskActivity.Name}"/>
                            <TextBlock Classes="settingDesc" Text="{Binding Catalog.AlertDiskActivity.Description}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <settings:NumericField Value="{Binding DiskActiveAlert.Value, Mode=TwoWay}"
                                                   Minimum="{Binding DiskActiveAlert.Minimum}"
                                                   Maximum="{Binding DiskActiveAlert.Maximum}"
                                                   Suffix="{Binding DiskActiveAlert.Suffix}" IsEnabled="{Binding DiskActiveAlert.IsEnabled}"/>
                            <ToggleButton Classes="toggle" IsChecked="{Binding DiskActiveAlert.IsEnabled}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="settingRow revealFlash" Tag="{x:Static settings:SettingId.AlertLowDiskFree}"
                        IsEnabled="{Binding ResourceAlerts}"
                        BorderBrush="{DynamicResource RowLine}" BorderThickness="0,1,0,0" Padding="0,9,0,0">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                            <TextBlock Classes="settingName" Text="{Binding Catalog.AlertLowDiskFree.Name}"/>
                            <TextBlock Classes="settingDesc" Text="{Binding Catalog.AlertLowDiskFree.Description}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <settings:NumericField Value="{Binding LowDiskFreeAlert.Value, Mode=TwoWay}"
                                                   Minimum="{Binding LowDiskFreeAlert.Minimum}"
                                                   Maximum="{Binding LowDiskFreeAlert.Maximum}"
                                                   Suffix="{Binding LowDiskFreeAlert.Suffix}" IsEnabled="{Binding LowDiskFreeAlert.IsEnabled}"/>
                            <ToggleButton Classes="toggle" IsChecked="{Binding LowDiskFreeAlert.IsEnabled}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="settingRow revealFlash" Tag="{x:Static settings:SettingId.AlertSustain}"
                        IsEnabled="{Binding ResourceAlerts}"
                        BorderBrush="{DynamicResource RowLine}" BorderThickness="0,1,0,0" Padding="0,9,0,0">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                            <TextBlock Classes="settingName" Text="{Binding Catalog.AlertSustain.Name}"/>
                            <TextBlock Classes="settingDesc" Text="{Binding Catalog.AlertSustain.Description}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <settings:NumericField Value="{Binding AlertSustain.Value, Mode=TwoWay}"
                                                   Minimum="{Binding AlertSustain.Minimum}"
                                                   Maximum="{Binding AlertSustain.Maximum}"
                                                   Suffix="{Binding AlertSustain.Suffix}"/>
                            <!-- Holds the switch column open on the one row that has no switch, so every
                                 number in the card still lines up. -->
                            <Border Width="40"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </controls:WidgetPanel>

        <!-- ===== Export & Data ===== -->
        <controls:WidgetPanel WidgetId="settings.export" Title="{Binding Catalog.ExportData.Section}">
            <StackPanel Spacing="14">
                <!-- The three actions share one search entry, so the row tag sits on the group rather
                     than on any one button. -->
                <Border Classes="settingRow revealFlash" Tag="{x:Static settings:SettingId.ExportData}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="action primary" Content="Export report (.txt)" Click="OnExportReportClick"/>
                        <Button Classes="action" Content="Export CSV" Click="OnExportCsvClick"/>
                        <Button Classes="action" Content="Copy diagnostics" Click="OnCopyDiagnosticsClick"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </controls:WidgetPanel>

        <TextBlock HorizontalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextFaint}"
                   Text="{Binding VersionText}"/>
    </StackPanel>
</UserControl>
