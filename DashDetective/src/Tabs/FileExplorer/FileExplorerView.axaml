<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fe="using:DashDetective.Tabs.FileExplorer"
             xmlns:layout="using:DashDetective.Shared.Layout"
             xmlns:controls="using:DashDetective.Shared.Controls"
             xmlns:nav="using:DashDetective.Shell.Navigation"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             x:DataType="fe:FileExplorerViewModel"
             x:Class="DashDetective.Tabs.FileExplorer.FileExplorerView">

    <!-- Read-only three-pane browser. Phase 2 wires the folder tree (left); the centre file list
         and right details pane are placeholders until Phases 3–4. Surfaces come from
         src/Shared/Styles; selection/hover colours use theme resources. -->
    <UserControl.Styles>
        <!-- Tree rows: tighten spacing and recolour selection/hover to match the design comp
             (AccentSoft selected, HoverOverlay hover) instead of the Fluent defaults. -->
        <Style Selector="TreeViewItem">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <!-- Suppress the Fluent default hover: a TreeViewItem's :pointerover is true whenever the
             pointer is over any descendant, so it would grey the whole ancestor chain. -->
        <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Real hover: keyed off the row border's OWN pointerover, so only the directly
             hovered row highlights (the border wraps just the header, not the children). -->
        <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        </Style>
        <!-- Selection is independent of hover and wins on the selected row. -->
        <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>
        <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>
        <!-- Expand/collapse glyph. Fluent draws an open, stroked V; the app's disclosure glyph is the
             filled triangle the widget headers and the Processes table draw as ▾/▸, so the tree is
             restyled to match rather than being the one place with a different shape.

             The chevron's Path lives inside the ToggleButton's OWN control theme, and a selector cannot
             cross two template boundaries — `TreeViewItem /template/ ToggleButton#… /template/ Path`
             matches nothing, which is what the first attempt did. Replacing the button's template is
             the reachable seam. Both carets are laid on one Panel with exactly one visible, the same
             idiom the Processes group headers use, because a style inside this template would need that
             second boundary again. -->
        <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Panel>
                            <Path Classes="treeCaret" Data="{x:Static nav:Icons.CaretRight}"
                                  IsVisible="{TemplateBinding IsChecked,
                                              Converter={x:Static BoolConverters.Not}}"/>
                            <Path Classes="treeCaret" Data="{x:Static nav:Icons.CaretDown}"
                                  IsVisible="{TemplateBinding IsChecked}"/>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Filled, so Fill and not Stroke; Uniform scales the 18x18-authored caret into the 8px box
             the tree's 12.5 row reads it against. -->
        <Style Selector="Path.treeCaret">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource TextMuted}"/>
        </Style>

        <Style Selector="TreeViewItem TextBlock.nodeName">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="TreeViewItem:selected TextBlock.nodeName">
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
        </Style>

        <!-- ===== File list ===== -->
        <!-- colHead / colHead.active / sortArrow are shared (src/Shared/Styles/SharedStyles.axaml). -->
        <Style Selector="Border.fileRow">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RowLine}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.fileRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        </Style>
        <Style Selector="Border.fileRow.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>
        <Style Selector="Border.fileRow TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.fileRow TextBlock.cellName">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- This pane is narrow even at the design width, so a long value (a full timestamp) has to
             ellipsize rather than be cut mid-character at the column edge. -->
        <Style Selector="Border.fileRow TextBlock.cellMeta">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="Border.fileRow TextBlock.cellSize">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- Hairline-thin indeterminate strip under the column header while a folder is being read.
             Track transparent so it rides the header's own hairline rather than drawing a second one. -->
        <Style Selector="ProgressBar.loadStrip">
            <Setter Property="Height" Value="3"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </Style>

        <!-- ===== Breadcrumb + filter chips ===== -->
        <!-- The chrome-less button wrapper that makes a whole crumb / chip clickable is the shared
             Button.bare (src/Shared/Styles/SharedStyles.axaml). -->
        <Style Selector="Button.crumb">
            <Setter Property="Padding" Value="2,0"/>
        </Style>
        <Style Selector="TextBlock.crumbText">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="TextBlock.crumbText.current">
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
        </Style>
        <Style Selector="Button.crumb:pointerover TextBlock.crumbText">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="TextBlock.crumbSep">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- The path box's refusal. Orange rather than a theme brush, matching the app's other
             transient failures (Processes' ActionMessage, the Toolkit form's field error). -->
        <Style Selector="TextBlock.pathError">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Orange}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Back / forward / up, beside the breadcrumb. Disabled state dims the glyph so the
             end of the trail (and a drive root) reads at a glance. -->
        <Style Selector="Button.navBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.navBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        </Style>
        <!-- Dim the glyph rather than letting the Fluent theme paint a filled disabled box, so a
             dead end reads as a faded arrow and the bar keeps the app's flat look. -->
        <Style Selector="Button.navBtn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.navBtn:disabled Path">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" RowSpacing="12">

        <!-- ===== Breadcrumb + filters ===== -->
        <!-- The second row carries the path box's complaint. It collapses out of the layout the rest of
             the time, so the bar keeps its height. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
              ColumnSpacing="10">

            <!-- Back / forward / up. The keyboard drives the same commands (Alt+←, Alt+→,
                 Backspace / Alt+↑); these keep the navigation discoverable for the mouse. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Classes="navBtn" ToolTip.Tip="Back (Alt+←)" Command="{Binding GoBackCommand}">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextTertiary}"
                          StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                          Data="M9,2 L4,7 L9,12"/>
                </Button>
                <Button Classes="navBtn" ToolTip.Tip="Forward (Alt+→)" Command="{Binding GoForwardCommand}">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextTertiary}"
                          StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                          Data="M5,2 L10,7 L5,12"/>
                </Button>
                <Button Classes="navBtn" ToolTip.Tip="Up one folder (Backspace)" Command="{Binding GoUpCommand}">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextTertiary}"
                          StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                          Data="M7,12 V3 M3,7 L7,3 L11,7"/>
                </Button>
            </StackPanel>

            <!-- Clicking the field anywhere but on a crumb starts editing the path, as Ctrl+L does —
                 the I-beam advertises it. The crumbs keep the hand cursor from Button.pick. -->
            <Border Grid.Column="1" Background="{DynamicResource FieldBackground}"
                    BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="6"
                    Padding="12,7" VerticalAlignment="Center" ClipToBounds="True"
                    Cursor="IBeam" PointerPressed="OnBreadcrumbPointerPressed">
                <!-- The trail and the editable path share this field and swap places: Ctrl+L or a click
                     reveals the box, Enter opens what was typed, Esc or clicking away restores the trail. -->
                <Panel>
                    <ItemsControl ItemsSource="{Binding Crumbs}" IsVisible="{Binding ShowCrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="fe:Crumb">
                                <StackPanel Orientation="Horizontal">
                                    <Button Classes="bare crumb" Command="{Binding SelectCommand}">
                                        <TextBlock Classes="crumbText" Classes.current="{Binding IsCurrent}"
                                                   Text="{Binding Label}"/>
                                    </Button>
                                    <TextBlock Classes="crumbSep" Text="{Binding Separator}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Tab completes the folder being typed; Enter is bound on the box rather than
                         through the shell, since the shortcut layer deliberately leaves Enter to
                         whatever text box has focus. -->
                    <controls:GhostCompletionBox x:Name="PathBox" IsVisible="{Binding IsPathEditing}"
                                                 FontSize="12.5" LostFocus="OnPathBoxLostFocus"
                                                 Text="{Binding PathText, Mode=TwoWay}"
                                                 Completion="{Binding PathCompletionText}"
                                                 EnterCommand="{Binding CommitPathCommand}"/>
                </Panel>
            </Border>

            <!-- Why the typed path was refused. The box stays open with the text, so this sits under
                 the field it belongs to rather than over the file list. -->
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="pathError" Margin="2,4,0,0"
                       Text="{Binding PathError}"
                       IsVisible="{Binding PathError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                        VerticalAlignment="Center">
                <!-- View-options dropdown: groups the checkbox toggles behind one button so the bar
                     stays uncluttered as options are added. A ToggleButton drives a plain Popup
                     (no light-dismiss overlay) so the rest of the window keeps receiving hover
                     while the menu is open; click the toggle again to close. -->
                <Panel>
                    <ToggleButton x:Name="OptionsButton" Classes="optionsToggle" Content="Options ▾"/>
                    <!-- Overlay-free popup keeps the rest of the window hoverable; close-on-outside-
                         click is emulated in code-behind (see OnWindowPointerPressed) instead of the
                         light-dismiss overlay that would block that hover. -->
                    <Popup x:Name="OptionsPopup" PlacementTarget="{Binding #OptionsButton}"
                           Placement="BottomEdgeAlignedRight" VerticalOffset="6"
                           IsLightDismissEnabled="False"
                           IsOpen="{Binding #OptionsButton.IsChecked, Mode=TwoWay}">
                        <Border Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                                CornerRadius="8" Padding="12" BoxShadow="{StaticResource ShadowPopup}">
                            <StackPanel Spacing="10">
                                <!-- Reveals OS hidden/system entries in list + tree. -->
                                <CheckBox Classes="optionCheck" Content="Show hidden"
                                          IsChecked="{Binding ShowHidden}"/>
                                <!-- Collapsing a parent also collapses everything under it. -->
                                <CheckBox Classes="optionCheck" Content="Collapse children with parent"
                                          IsChecked="{Binding CollapseChildrenWithParent}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Panel>
                <Border Classes="segments" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Filters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="fe:FilterOption">
                                <Button Classes="bare" Command="{Binding SelectCommand}">
                                    <Border Classes="seg" Classes.selected="{Binding IsSelected}">
                                        <TextBlock Text="{Binding Label}"/>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ===== Three panes ===== -->
        <!-- Fixed side panels + star middle, split by draggable GridSplitters. The 12px splitter
             columns stand in for the old 12px ColumnSpacing. Widths reset each launch (no persist);
             min/max keep the file list usable at the window's 920px minimum. -->
        <!-- The side panes collapse rather than clip once the page can no longer hold their minimums:
             details first, then the tree (see FileExplorerPanes). The code-behind zeroes the collapsed
             column so it stops reserving width. -->
        <Grid Grid.Row="1" SizeChanged="OnPaneAreaSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180" MaxWidth="420"/>  <!-- left tree -->
                <ColumnDefinition Width="Auto"/>                               <!-- splitter -->
                <ColumnDefinition Width="*"   MinWidth="320"/>                 <!-- file list -->
                <ColumnDefinition Width="Auto"/>                               <!-- splitter -->
                <ColumnDefinition Width="300" MinWidth="220" MaxWidth="460"/>  <!-- details -->
            </Grid.ColumnDefinitions>

        <!-- ===== Folder tree ===== -->
        <Border x:Name="TreePane" Grid.Column="0" Classes="panel" Padding="8">
            <TreeView ItemsSource="{Binding RootNodes}"
                      Background="Transparent" BorderThickness="0" Padding="0">
                <TreeView.ItemContainerTheme>
                    <ControlTheme TargetType="TreeViewItem" x:DataType="fe:FileSystemNode"
                                  BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    </ControlTheme>
                </TreeView.ItemContainerTheme>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="fe:FileSystemNode">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Data="{Binding Glyph}" Stroke="{Binding IconBrush}"
                                  StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round"
                                  Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Classes="nodeName" Text="{Binding Name}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Classes="paneSplitter"/>

        <!-- ===== File list ===== -->
        <Border Grid.Column="2" Classes="panel" Padding="0" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">

                <!-- Column header. Each cell is a chrome-less button that sorts by its column;
                     the active column tints and shows a ↑/↓ arrow (bound to the SortColumn VMs). -->
                <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource Hairline}"
                        BorderThickness="0,0,0,1">
                    <!-- This grid's width is exactly what the columns get, so it (not the outer panel)
                         is what the view model measures against when deciding how many still fit. -->
                    <Grid ColumnSpacing="8" SizeChanged="OnTableSizeChanged"
                          layout:GridColumns.Definitions="{Binding ColumnLayout}">
                        <controls:SortableColumnHeader Grid.Column="0" Text="NAME" Column="{Binding NameSort}"/>
                        <controls:SortableColumnHeader Grid.Column="1" Text="TYPE" Column="{Binding TypeSort}"
                                                       IsVisible="{Binding ShowTypeColumn}"/>
                        <controls:SortableColumnHeader Grid.Column="2" Text="MODIFIED" Column="{Binding ModifiedSort}"
                                                       IsVisible="{Binding ShowModifiedColumn}"/>
                        <controls:SortableColumnHeader Grid.Column="3" Text="SIZE" Column="{Binding SizeSort}"
                                                       ContentAlignment="Right" ArrowFirst="True"/>
                    </Grid>
                </Border>

                <!-- Rows. The list is cleared the moment a navigation starts, so the placeholders
                     below are what stands in for it: the previous folder's rows are neither shown nor
                     clickable while the new one is read. -->
                <Panel Grid.Row="1">
                    <ScrollViewer x:Name="FileListScroll" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding VisibleEntries}">
                            <!-- Virtualized: a large folder would otherwise realize every row's border,
                                 grid, glyph and four text blocks up front and freeze the UI for seconds. -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="fe:FileEntry">
                                    <Border Classes="fileRow" Classes.selected="{Binding IsSelected}"
                                            Background="Transparent"
                                            Tapped="OnEntryTapped" DoubleTapped="OnEntryDoubleTapped">
                                        <!-- Columns come from the page view model, not the entry, so every
                                             row and the header share one definition and stay aligned. -->
                                        <Grid ColumnSpacing="8"
                                              layout:GridColumns.Definitions="{Binding $parent[UserControl].((fe:FileExplorerViewModel)DataContext).ColumnLayout}">
                                            <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                                                <Path Grid.Column="0" Data="{Binding Glyph}"
                                                      Stroke="{Binding IconBrush}" StrokeThickness="1.3"
                                                      StrokeLineCap="Round" StrokeJoin="Round"
                                                      Width="15" Height="15" Stretch="Uniform"
                                                      VerticalAlignment="Center" Margin="0,0,9,0"/>
                                                <TextBlock Grid.Column="1" Classes="cellName"
                                                           Text="{Binding Name}"/>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Classes="cellMeta"
                                                       Text="{Binding TypeName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding $parent[UserControl].((fe:FileExplorerViewModel)DataContext).ShowTypeColumn}"/>
                                            <TextBlock Grid.Column="2" Classes="cellMeta"
                                                       Text="{Binding ModifiedText}"
                                                       IsVisible="{Binding $parent[UserControl].((fe:FileExplorerViewModel)DataContext).ShowModifiedColumn}"/>
                                            <TextBlock Grid.Column="3" Classes="cellSize"
                                                       Text="{Binding SizeText}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Classes="cardSub" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding IsLoading}" Text="Loading…"/>
                    <!-- Why the list is blank. A protected folder, one that has vanished, a filter that
                         hid everything and a genuinely empty folder all used to read the same; the
                         wording comes from FolderMessages so the pane can tell them apart. -->
                    <StackPanel Spacing="6" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding FolderMessageTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding FolderMessageTitle}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding FolderMessageHint}" FontSize="11.5"
                                   Foreground="{DynamicResource TextSubtle}"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <ProgressBar Classes="loadStrip" IsIndeterminate="True" VerticalAlignment="Top"
                                 IsVisible="{Binding IsLoading}"/>
                </Panel>
            </Grid>
        </Border>

        <GridSplitter x:Name="DetailsSplitter" Grid.Column="3" Classes="paneSplitter"/>

        <!-- ===== Details / preview ===== -->
        <Border x:Name="DetailsPane" Grid.Column="4" Classes="panel">
            <Panel>
                <!-- Empty state -->
                <TextBlock Classes="cardSub" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding HasNoSelection}"
                           Text="Select a file to see details"/>

                <!-- Details for the selected entry -->
                <ScrollViewer IsVisible="{Binding HasSelection}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- Right margin reserves a gutter so the scrollbar clears the detail values. -->
                    <StackPanel Spacing="12" Margin="0,0,14,0">
                        <!-- Preview swatch: scaled file glyph on a subtle panel (approximating the
                             comp's hatch). -->
                        <Border Height="120" CornerRadius="8"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
                            <Path Data="{Binding SelectedEntry.Glyph}"
                                  Stroke="{Binding SelectedEntry.IconBrush}" StrokeThickness="1.3"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Width="44" Height="44" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="{Binding SelectedEntry.Name}" FontSize="14"
                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextStrong}"/>

                        <StackPanel>
                            <controls:InfoRow Key="Type" Value="{Binding SelectedEntry.TypeName}"/>
                            <controls:InfoRow Key="Size" Value="{Binding SelectedEntry.SizeText}"/>
                            <controls:InfoRow Key="Modified" Value="{Binding SelectedEntry.ModifiedText}"/>
                            <controls:InfoRow Key="Created" Value="{Binding SelectedEntry.CreatedText}"/>
                            <controls:InfoRow Key="Attributes" Value="{Binding SelectedEntry.AttributesText}"/>
                            <controls:ExpandablePathRow Key="Location" Value="{Binding SelectedEntry.FullPath}"/>
                        </StackPanel>

                        <!-- Actions -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Classes="action primary" Content="Open"
                                    Command="{Binding OpenCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="1" Classes="action" Content="Properties"
                                    Click="OnPropertiesClick"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </Border>
        </Grid>
    </Grid>
</UserControl>
