<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:DashDetective.Shared.Controls"
             xmlns:layout="using:DashDetective.Shared.Layout"
             xmlns:vm="using:DashDetective.Tabs.Performance"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             x:DataType="vm:PerformanceViewModel"
             x:Class="DashDetective.Tabs.Performance.PerformanceView">

    <!-- Task-Manager-style master-detail: the resource-selector rail (left) swaps the detail pane
         (right). Phase 3 wires the selectable resource list + selection; the chart (Phase 4) and stat
         tiles (Phase 5) fill the detail pane. Surfaces/styles come from src/Shared/Styles. -->
    <UserControl.Styles>
        <!-- The chrome-less click wrapper is the shared Button.bare (src/Shared/Styles/SharedStyles). -->

        <!-- Resource selector cards: a name + sub-label on the left, a tinted value on the right.
             Selected uses AccentSoft fill + Accent border (the design comp's cyan highlight). -->
        <Style Selector="Border.resCard">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.resCard:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        </Style>
        <Style Selector="Border.resCard.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Border.resCard TextBlock.resName">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="Border.resCard TextBlock.resSub">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="Border.resCard TextBlock.resVal">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.resCard TextBlock.resUnit">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- Detail stat tiles: a small label over a larger value. -->
        <Style Selector="Border.statTile TextBlock.statLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="Border.statTile TextBlock.statValue">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Rail scope: "Primary" shows one of each kind; "All devices" shows every detected instance
             (e.g. all disks). Reuses the shared segmented-toggle styles (Border.segments / seg). -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Classes="cardSub" VerticalAlignment="Center"
                       Text="Detected configuration"/>
            <Border Grid.Column="1" Classes="segments">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="bare" Command="{Binding SelectPrimaryScopeCommand}">
                        <Border Classes="seg" Classes.selected="{Binding !ShowAllDevices}">
                            <TextBlock Text="Primary"/>
                        </Border>
                    </Button>
                    <Button Classes="bare" Command="{Binding SelectAllScopeCommand}">
                        <Border Classes="seg" Classes.selected="{Binding ShowAllDevices}">
                            <TextBlock Text="All devices"/>
                        </Border>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180" MaxWidth="360"/>  <!-- resource selector -->
                <ColumnDefinition Width="Auto"/>                               <!-- splitter -->
                <ColumnDefinition Width="*"   MinWidth="360"/>                 <!-- detail pane -->
            </Grid.ColumnDefinitions>

        <!-- ===== Resource selector (left) ===== -->
        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Resources}" Margin="0,0,2,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResourceRow">
                        <Button Classes="bare" Command="{Binding SelectCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Border Classes="resCard" Classes.selected="{Binding IsSelected}"
                                    ToolTip.Tip="{Binding Note}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="resName" Text="{Binding Name}"/>
                                        <TextBlock Classes="resSub" Text="{Binding Sub}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Classes="resVal" Text="{Binding ValueText}"
                                                   Foreground="{Binding ValueBrush}"/>
                                        <TextBlock Classes="resUnit" Text="{Binding Unit}"
                                                   Foreground="{Binding ValueBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <GridSplitter Grid.Column="1" Classes="paneSplitter"/>

        <!-- ===== Detail pane (right) ===== -->
        <!-- Stacks the utilization chart (Phase 4); the stat tiles (Phase 5) go below it. -->
        <StackPanel Grid.Column="2" Spacing="12">

            <!-- Utilization chart: header (name + spec), caption, and the fixed-axis area chart tinted
                 in the resource's colour. Reuses the shared Sparkline with the background grid, like the Dashboard. -->
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="panelTitle"
                                   Text="{Binding SelectedResource.Name}"/>
                        <TextBlock Grid.Column="1" Classes="cardSub" VerticalAlignment="Center"
                                   Text="{Binding SelectedResource.Spec}"/>
                    </Grid>
                    <!-- Caption + the per-resource Overall/Detailed toggle (shown only when the resource
                         supports it: CPU logical processors / GPU engines). -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="cardSub" VerticalAlignment="Center"
                                   Text="{Binding SelectedResource.ChartCaption}"/>
                        <Border Grid.Column="1" Classes="segments"
                                IsVisible="{Binding SelectedResource.SupportsDetail}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="bare" Command="{Binding SelectOverallViewCommand}">
                                    <Border Classes="seg" Classes.selected="{Binding !SelectedResource.IsDetailed}">
                                        <TextBlock Text="Overall"/>
                                    </Border>
                                </Button>
                                <Button Classes="bare" Command="{Binding SelectDetailedViewCommand}">
                                    <Border Classes="seg" Classes.selected="{Binding SelectedResource.IsDetailed}">
                                        <TextBlock Text="{Binding SelectedResource.DetailLabel}"/>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Why the chart below is empty, for a resource that reports no figure (a GPU whose
                         driver publishes none). Takes no space when there is nothing to say. -->
                    <TextBlock Classes="cardSub" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedResource.HasNote}"
                               Text="{Binding SelectedResource.Note}"/>

                    <!-- The key for the one row that draws two series; a single line needs none, since the
                         header above already names it. -->
                    <controls:ChartLegend HorizontalAlignment="Right"
                                          IsVisible="{Binding SelectedResource.HasSecondSeries}"
                                          Label1="{Binding SelectedResource.LegendLabel1}"
                                          Brush1="{Binding SelectedResource.ValueBrush}"
                                          Label2="{Binding SelectedResource.LegendLabel2}"
                                          Brush2="{Binding SelectedResource.ValueBrush2}"/>

                    <!-- Overall: one fixed-axis area chart tinted in the resource's colour, plus an optional
                         second series on the same axis (the adapter row's upload beside its download). -->
                    <controls:Sparkline Classes="chartHero" Fill="True" ShowGrid="True" StrokeThickness="1.8"
                                        YMin="0" YMax="100"
                                        IsVisible="{Binding !SelectedResource.IsDetailed}"
                                        Stroke="{Binding SelectedResource.ValueBrush}"
                                        Points="{Binding SelectedResource.Points}"
                                        Stroke2="{Binding SelectedResource.ValueBrush2}"
                                        Points2="{Binding SelectedResource.Points2}"
                                        AxisMaxLabel="{Binding SelectedResource.AxisMaxLabel}"
                                        AxisMidLabel="{Binding SelectedResource.AxisMidLabel}"
                                        AxisMinLabel="{Binding SelectedResource.AxisMinLabel}"
                                        AxisStartLabel="{Binding ChartRangeStart}" AxisEndLabel="now"
                                        StatusText="{Binding SelectedResource.ChartStatus}"/>

                    <!-- Detailed: one mini chart per logical processor / engine in a compact square grid.
                         DetailColumns is the ceiling rather than a fixed count,
                         so the square-ish shape holds on a wide pane but wraps below it when a cell
                         would drop under 110px. The panel sizes to its content up to MaxHeight, so a
                         small grid shows flush while many cores scroll. -->
                    <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding SelectedResource.IsDetailed}">
                        <ItemsControl ItemsSource="{Binding SelectedResource.SubCharts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <layout:UniformFlowPanel x:DataType="vm:PerformanceViewModel"
                                                             MinItemWidth="110" ColumnSpacing="8" RowSpacing="8"
                                                             MaxColumns="{Binding SelectedResource.DetailColumns}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SubChart">
                                    <Border Padding="8" CornerRadius="6"
                                            Background="{DynamicResource AppBackground}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Label}" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <controls:Sparkline Classes="chartCell" Fill="True" ShowGrid="True"
                                                                GridRows="2" GridColumns="6" YMin="0" YMax="100"
                                                                Stroke="{Binding Stroke}" Points="{Binding Points}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Stat tiles: the selected resource's readouts (design comp's statMap) four for most,
                 six for CPU wrapping to further rows once a tile would fall under 150px. -->
            <ItemsControl ItemsSource="{Binding SelectedResource.Stats}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <layout:UniformFlowPanel MinItemWidth="150" MaxColumns="4"
                                                 ColumnSpacing="12" RowSpacing="12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatTile">
                        <Border Classes="card statTile">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="statLabel" Text="{Binding Label}"/>
                                <TextBlock Classes="statValue" Text="{Binding Value}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        </Grid>
    </Grid>
</UserControl>
