<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:DashDetective.Shared.Controls"
             xmlns:layout="using:DashDetective.Shared.Layout"
             xmlns:vm="using:DashDetective.Tabs.Performance"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             x:DataType="vm:PerformanceViewModel"
             x:Class="DashDetective.Tabs.Performance.PerformanceView">

    <!-- Task-Manager-style master-detail: the resource-selector rail (left) swaps the detail pane
         (right). Phase 3 wires the selectable resource list + selection; the chart (Phase 4) and stat
         tiles (Phase 5) fill the detail pane. Surfaces/styles come from src/Shared/Styles. -->
    <UserControl.Styles>
        <!-- The chrome-less click wrapper is the shared Button.bare (src/Shared/Styles/SharedStyles). -->

        <!-- Resource selector cards: a name + sub-label on the left, a tinted value on the right. The
             surface, hover and selected states are the shared Border.card + .selectable; only the four
             text roles inside one stay local, since no other tab lists devices this way. -->
        <Style Selector="TextBlock.resName">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.resSub">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.resVal">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.resUnit">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <!-- A row showing a pair (receive over send) stacks two values where one used to sit, so it
             steps down a size to keep the card the same height as the rest. Declared after .resVal, which
             is what makes it win: Avalonia ranks equally-close styles by order, not specificity. -->
        <Style Selector="TextBlock.resVal.pair">
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- The shared segment sized for the rail: no other tab puts one in a 180px column, so the
             narrower padding and type stay local (a local style outranks the shared Border.seg). -->
        <Style Selector="Border.seg.compact">
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style Selector="Border.seg.compact TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

    </UserControl.Styles>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="180" MaxWidth="360"/>  <!-- resource selector -->
            <ColumnDefinition Width="Auto"/>                               <!-- splitter -->
            <ColumnDefinition Width="*"   MinWidth="360"/>                 <!-- detail pane -->
        </Grid.ColumnDefinitions>

        <!-- ===== Resource selector (left) ===== -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*">

            <!-- Rail scope: "Primary" shows one of each kind; "All devices" shows every detected instance
                 (e.g. all disks). It heads the rail because the rail is all it filters — over the whole
                 page it read as if it scoped the detail pane too. Equal columns rather than a horizontal
                 StackPanel, so the pair splits the rail at any splitter position. -->
            <Border Grid.Row="0" Classes="segments" Margin="0,0,2,8"
                    ToolTip.Tip="Show one device of each kind, or every device detected">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Button Grid.Column="0" Classes="bare" Command="{Binding SelectPrimaryScopeCommand}"
                            HorizontalContentAlignment="Stretch">
                        <Border Classes="seg compact" Classes.selected="{Binding !ShowAllDevices}">
                            <TextBlock Text="Primary"/>
                        </Border>
                    </Button>
                    <Button Grid.Column="1" Classes="bare" Command="{Binding SelectAllScopeCommand}"
                            HorizontalContentAlignment="Stretch">
                        <Border Classes="seg compact" Classes.selected="{Binding ShowAllDevices}">
                            <TextBlock Text="All devices"/>
                        </Border>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Resources}" Margin="0,0,2,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- One column: a flow panel rather than a StackPanel because it is the
                                 panel that knows how to reorder. Only the grip drags, so a press
                                 anywhere else on the row still selects the device. -->
                            <layout:UniformFlowPanel MaxColumns="1" RowSpacing="8"
                                                     DragGrip="Marked"
                                                     Order="{Binding ResourceOrder.Order, Mode=TwoWay}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ResourceRow">
                            <Button Classes="bare" Command="{Binding SelectCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Border Classes="card selectable" Classes.selected="{Binding IsSelected}"
                                        ToolTip.Tip="{Binding NoteTip}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <!-- The drag handle, and the only part of the row that is
                                             one. The mark and the hit target are the BORDER: a bare
                                             stroked Path is hit-testable only along its two 1.6px
                                             lines, which is not something a pointer can find. -->
                                        <Border Grid.Column="0" Background="Transparent" Width="14"
                                                layout:Reorder.IsGrip="True">
                                            <Path Classes="dragGrip" Data="M0,0 L0,15 M5,0 L5,15"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="resName" Text="{Binding Name}"/>
                                            <TextBlock Classes="resSub" Text="{Binding Sub}"/>
                                        </StackPanel>
                                        <!-- One line per series, tinted like the chart it belongs to: an
                                             adapter's card names the whole adapter, so a receive-only
                                             figure under it described half its traffic. Both lines share
                                             the Unit, which is already the larger of the pair's. -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="2"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Classes="resUnit" Text="{Binding ValueGlyph}"
                                                           IsVisible="{Binding HasSecondSeries}"
                                                           Foreground="{Binding ValueBrush}"/>
                                                <TextBlock Classes="resVal" Text="{Binding ValueText}"
                                                           Classes.pair="{Binding HasSecondSeries}"
                                                           Foreground="{Binding ValueBrush}"/>
                                                <TextBlock Classes="resUnit" Text="{Binding Unit}"
                                                           Foreground="{Binding ValueBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="2"
                                                        HorizontalAlignment="Right"
                                                        IsVisible="{Binding HasSecondSeries}">
                                                <TextBlock Classes="resUnit" Text="{Binding ValueGlyph2}"
                                                           Foreground="{Binding ValueBrush2}"/>
                                                <TextBlock Classes="resVal pair" Text="{Binding ValueText2}"
                                                           Foreground="{Binding ValueBrush2}"/>
                                                <TextBlock Classes="resUnit" Text="{Binding Unit}"
                                                           Foreground="{Binding ValueBrush2}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Column="1" Classes="paneSplitter"/>

        <!-- ===== Detail pane (right) ===== -->
        <!-- Stacks the utilization chart (Phase 4); the stat tiles (Phase 5) go below it. -->
        <StackPanel Grid.Column="2" Spacing="12">

            <!-- Utilization chart: header (name + spec), caption, and the fixed-axis area chart tinted
                 in the resource's colour. Reuses the shared Sparkline with the background grid, like the Dashboard. -->
            <controls:WidgetPanel WidgetId="performance.chart"
                                  Title="{Binding SelectedResource.Name}">
                <!-- The jump link goes in HeaderLead so it sits against the name rather than making the
                     title itself clickable: a bare title offers no resting cue that it goes anywhere.
                     Hidden on a resource with no home tab (HasLink), the same way the Overall/Detailed
                     toggle below is gated on SupportsDetail. -->
                <controls:WidgetPanel.HeaderLead>
                    <Button Classes="link" Margin="10,0,0,0"
                            IsVisible="{Binding SelectedResource.HasLink}"
                            Command="{Binding SelectedResource.Link.Command}"
                            ToolTip.Tip="Open this device on the tab that owns it">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding SelectedResource.Link.Label}"
                                       VerticalAlignment="Center"/>
                            <Path Classes="linkArrow" Width="11" Height="11" Stretch="Uniform"
                                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                  VerticalAlignment="Center"
                                  Data="M2,9 L9,2 M4,2 L9,2 L9,7"/>
                        </StackPanel>
                    </Button>
                </controls:WidgetPanel.HeaderLead>
                <controls:WidgetPanel.HeaderContent>
                    <TextBlock Classes="cardSub" Text="{Binding SelectedResource.Spec}"/>
                </controls:WidgetPanel.HeaderContent>
                <StackPanel Spacing="8">
                    <!-- Caption + the per-resource Overall/Detailed toggle (shown only when the resource
                         supports it: CPU logical processors / GPU engines). -->
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Trims: the star column shrinks under the toggle beside it, and an untrimmed
                             TextBlock overflows its column rather than clipping to it. -->
                        <TextBlock Grid.Column="0" Classes="cardSub" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding SelectedResource.ChartCaption}"/>
                        <Border Grid.Column="1" Classes="segments"
                                IsVisible="{Binding SelectedResource.SupportsDetail}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="bare" Command="{Binding SelectOverallViewCommand}">
                                    <Border Classes="seg" Classes.selected="{Binding !SelectedResource.IsDetailed}">
                                        <TextBlock Text="Overall"/>
                                    </Border>
                                </Button>
                                <Button Classes="bare" Command="{Binding SelectDetailedViewCommand}">
                                    <Border Classes="seg" Classes.selected="{Binding SelectedResource.IsDetailed}">
                                        <TextBlock Text="{Binding SelectedResource.DetailLabel}"/>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Why the chart below is empty, for a resource that reports no figure (a GPU whose
                         driver publishes none). Takes no space when there is nothing to say. -->
                    <TextBlock Classes="cardSub" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedResource.HasNote}"
                               Text="{Binding SelectedResource.Note}"/>

                    <!-- The key for the one row that draws two series; a single line needs none, since the
                         header above already names it. -->
                    <controls:ChartLegend HorizontalAlignment="Right"
                                          IsVisible="{Binding SelectedResource.HasSecondSeries}"
                                          Label1="{Binding SelectedResource.LegendLabel1}"
                                          Brush1="{Binding SelectedResource.ValueBrush}"
                                          Label2="{Binding SelectedResource.LegendLabel2}"
                                          Brush2="{Binding SelectedResource.ValueBrush2}"/>

                    <!-- Overall: one fixed-axis area chart tinted in the resource's colour, plus an optional
                         second series on the same axis (the adapter row's upload beside its download). -->
                    <controls:Sparkline Classes="chartHero" Fill="True" ShowGrid="True" StrokeThickness="1.8"
                                        YMin="0" YMax="100"
                                        IsVisible="{Binding !SelectedResource.IsDetailed}"
                                        Stroke="{Binding SelectedResource.ValueBrush}"
                                        Points="{Binding SelectedResource.Points}"
                                        Stroke2="{Binding SelectedResource.ValueBrush2}"
                                        Points2="{Binding SelectedResource.Points2}"
                                        AxisValueLabels="{Binding SelectedResource.AxisValueLabels}"
                                        AxisTimeLabels="{Binding ChartTimeLabels}"
                                        AxisYTitle="{Binding SelectedResource.AxisYTitle}"
                                        AxisXTitle="Time"
                                        StatusText="{Binding SelectedResource.ChartStatus}"/>

                    <!-- Detailed: one mini chart per logical processor / engine. Uncapped like the
                         Dashboard card strip, so the cells reflow to fill the pane instead of stretching;
                         110px is the width below which one wraps. The panel sizes to its content up to
                         MaxHeight, so a small grid shows flush while many cores scroll. -->
                    <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding SelectedResource.IsDetailed}">
                        <ItemsControl ItemsSource="{Binding SelectedResource.SubCharts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <layout:UniformFlowPanel MinItemWidth="140" ColumnSpacing="8" RowSpacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SubChart">
                                    <Border Padding="8" CornerRadius="6"
                                            Background="{DynamicResource AppBackground}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Label}" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <controls:Sparkline Classes="chartCell" Fill="True" ShowGrid="True"
                                                                GridRows="2" GridColumns="6" YMin="0" YMax="100"
                                                                Stroke="{Binding Stroke}" Points="{Binding Points}"
                                                                AxisValueLabels="{Binding AxisLabels}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </controls:WidgetPanel>

            <!-- Stat tiles: the selected resource's readouts (design comp's statMap) four for most, six
                 for CPU. Uncapped like the Dashboard card strip, so a wide pane gains columns rather than
                 widening the tiles; 150px is the width below which one wraps. -->
            <ItemsControl ItemsSource="{Binding SelectedResource.Stats}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <layout:UniformFlowPanel MinItemWidth="150" ColumnSpacing="12" RowSpacing="12"
                                                 DragGrip="Item"
                                                 Order="{Binding SelectedResource.StatOrder.Order, Mode=TwoWay}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatTile">
                        <Border Classes="card">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="tileLabel" Text="{Binding Label}"/>
                                <TextBlock Classes="tileValue" Text="{Binding Value}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
