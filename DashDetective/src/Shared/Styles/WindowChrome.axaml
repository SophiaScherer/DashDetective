<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DashDetective.Shared.Controls">
    <!--
      The caption buttons of a window that draws its own title bar (WindowChrome.Custom).

      Avalonia 12 draws these itself once a window extends into its title bar, and answers WM_NCHITTEST
      over each with the button's role: HTMINBUTTON, HTMAXBUTTON, HTCLOSE. That is what keeps them native
      in behavior, the Windows 11 snap flyout on the maximize button included. The roles, the PART_ names
      (which Avalonia wires to minimize, maximize and close) and the non-null Background on each surface
      (without which only the glyph's stroke would be hit) are load-bearing.

      This replaces Fluent's theme, which has no high-contrast colors and paints a second title of its own
      over the window content. Sizes come from TitleBarRules, so the bar beneath cannot drift from them.
    -->

    <ControlTheme x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Width" Value="{x:Static controls:TitleBarRules.CaptionButtonWidth}"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <!-- Native caption buttons are not in the tab order. -->
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource HoverOverlayStrong}"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
        </Style>

        <!-- Close turns red, as it does everywhere else on Windows. -->
        <Style Selector="^.close:pointerover">
            <Setter Property="Background" Value="{DynamicResource CaptionCloseHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnCaptionClose}"/>
        </Style>
        <Style Selector="^.close:pressed">
            <Setter Property="Background" Value="{DynamicResource CaptionClosePressed}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnCaptionClose}"/>
        </Style>
    </ControlTheme>

    <!-- Glyphs on a 10x10 grid, stroked at 1px like the system's own. -->
    <ControlTheme x:Key="CaptionGlyph" TargetType="Path">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
    </ControlTheme>

    <ControlTheme x:Key="AppWindowDecorations" TargetType="WindowDrawnDecorations">
        <Setter Property="DefaultTitleBarHeight" Value="{x:Static controls:TitleBarRules.DefaultHeight}"/>
        <!-- Windows asks for the title bar alone and keeps its own frame and shadow. -->
        <Setter Property="DefaultFrameThickness" Value="0"/>
        <Setter Property="DefaultShadowThickness" Value="0"/>
        <Setter Property="Template">
            <WindowDrawnDecorationsTemplate>
                <WindowDrawnDecorationsContent>
                    <WindowDrawnDecorationsContent.Overlay>
                        <StackPanel x:Name="PART_OverlayPanel" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Height="{TemplateBinding TitleBarHeight}"
                                    IsVisible="{TemplateBinding HasTitleBar}">
                            <Button x:Name="PART_MinimizeButton" Theme="{StaticResource CaptionButton}"
                                    WindowDecorationProperties.ElementRole="MinimizeButton">
                                <Path Theme="{StaticResource CaptionGlyph}" Data="M0,5.5 H10"/>
                            </Button>
                            <Button x:Name="PART_MaximizeButton" Theme="{StaticResource CaptionButton}"
                                    WindowDecorationProperties.ElementRole="MaximizeButton">
                                <Panel>
                                    <Path x:Name="MaximizeGlyph" Theme="{StaticResource CaptionGlyph}"
                                          Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"/>
                                    <Path x:Name="RestoreGlyph" Theme="{StaticResource CaptionGlyph}"
                                          Data="M2.5,2.5 V0.5 H9.5 V7.5 H7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z"/>
                                </Panel>
                            </Button>
                            <Button x:Name="PART_CloseButton" Classes="close" Theme="{StaticResource CaptionButton}"
                                    WindowDecorationProperties.ElementRole="CloseButton">
                                <Path Theme="{StaticResource CaptionGlyph}" Data="M0,0 L10,10 M10,0 L0,10"/>
                            </Button>
                        </StackPanel>
                    </WindowDrawnDecorationsContent.Overlay>
                </WindowDrawnDecorationsContent>
            </WindowDrawnDecorationsTemplate>
        </Setter>

        <!-- Both states are styled rather than one set in markup: a local IsVisible would outrank the
             :maximized rule and the restore glyph would never appear. -->
        <Style Selector="^ /template/ Path#RestoreGlyph">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="^:maximized /template/ Path#MaximizeGlyph">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="^:maximized /template/ Path#RestoreGlyph">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- A button whose action the platform does not offer is not drawn at all. -->
        <Style Selector="^:not(:has-minimize) /template/ Button#PART_MinimizeButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="^:not(:has-maximize) /template/ Button#PART_MaximizeButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </ControlTheme>
</ResourceDictionary>
