<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DashDetective.Shared.Controls">
    <!-- The WidgetPanel template. TemplateBinding throughout, which is what satisfies compiled
         bindings without an x:DataType. The surface repeats Border.panel's setters because a
         templated child cannot pick up a class the call site never writes. -->
    <Style Selector="controls|WidgetPanel">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource Hairline}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPanel}"
                        Padding="{StaticResource PanelPadding}">
                    <DockPanel LastChildFill="True">
                        <!-- Title | HeaderLead | HeaderContent (right). Each reserves room only when set. -->
                        <StackPanel x:Name="PART_Header" DockPanel.Dock="Top" Spacing="2"
                                    Margin="{StaticResource WidgetHeaderMargin}">
                            <Grid ColumnDefinitions="Auto,Auto,*">
                                <TextBlock Grid.Column="0" Classes="panelTitle"
                                           VerticalAlignment="Center"
                                           Text="{TemplateBinding Title}"
                                           IsVisible="{TemplateBinding Title,
                                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                  Content="{TemplateBinding HeaderLead}"
                                                  IsVisible="{TemplateBinding HeaderLead,
                                                              Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center"
                                                  HorizontalAlignment="Right"
                                                  Content="{TemplateBinding HeaderContent}"
                                                  IsVisible="{TemplateBinding HeaderContent,
                                                              Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            </Grid>
                            <TextBlock Classes="cardSub" Text="{TemplateBinding Subtitle}"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{TemplateBinding Subtitle,
                                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Picked up: lifted above its neighbours and accented, so the gap it left reads as the target. -->
    <Style Selector="controls|WidgetPanel.dragging">
        <Setter Property="Opacity" Value="0.92"/>
    </Style>
    <Style Selector="controls|WidgetPanel.dragging /template/ Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="BoxShadow" Value="{StaticResource ShadowDrag}"/>
    </Style>

    <!-- The same, for a plain surface dragged out of a strip: those are cards rather than widgets,
         so they have no template to reach into. -->
    <Style Selector="Border.panel.dragging">
        <Setter Property="Opacity" Value="0.92"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="BoxShadow" Value="{StaticResource ShadowDrag}"/>
    </Style>

    <!-- Hit-testable so a press on the empty part of the header still reaches the board. The drag
         cursor is NOT set here: a style cannot tell whether this panel sits in a WidgetBoard, and one
         that said Hand on every header advertised a drag on the three tabs that have no board.
         WidgetBoard sets it from the same predicate that starts a drag. -->
    <Style Selector="controls|WidgetPanel /template/ StackPanel#PART_Header">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- WidgetTable: header above a body that scrolls, both inset by the same scrollbar gutter. -->
    <Style Selector="controls|WidgetTable">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel LastChildFill="True">
                    <ContentPresenter x:Name="PART_TableHeader" DockPanel.Dock="Top"
                                      Content="{TemplateBinding Header}"
                                      Margin="{TemplateBinding Gutter}"/>
                    <ScrollViewer x:Name="PART_BodyScroll" MaxHeight="{TemplateBinding MaxBodyHeight}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="{TemplateBinding BodyScrollBars}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="{TemplateBinding Gutter}"/>
                    </ScrollViewer>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- A widget with no heading at all: drop the header's bottom margin so the body starts at the
         panel's own padding rather than 10px below it. -->
    <Style Selector="controls|WidgetPanel.headless /template/ StackPanel#PART_Header">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="IsVisible" Value="False"/>
    </Style>
</Styles>
