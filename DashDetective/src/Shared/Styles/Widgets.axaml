<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DashDetective.Shared.Controls">
    <!-- The WidgetPanel template. TemplateBinding throughout, which is what satisfies compiled
         bindings without an x:DataType. The surface repeats Border.panel's setters because a
         templated child cannot pick up a class the call site never writes. -->
    <Style Selector="controls|WidgetPanel">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource Hairline}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPanel}"
                        Padding="{StaticResource PanelPadding}">
                    <DockPanel LastChildFill="True">
                        <!-- Title | HeaderLead | HeaderContent (right). Each reserves room only when set. -->
                        <StackPanel x:Name="PART_Header" DockPanel.Dock="Top" Spacing="2"
                                    Margin="{StaticResource WidgetHeaderMargin}">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                                <!-- The fold chevron, present only for a panel handed a store. A plain
                                     Button rather than a ToggleButton: Fluent's checked/pressed states
                                     would all need undoing, and the shared Button.bare already strips
                                     the chrome. WidgetBoard.TryGetHandle refuses a drag with a button in
                                     its path, which is what lets this share a header with the drag — so
                                     the taller target below also means slightly more of the header
                                     refuses a drag, all of it inside the panel's own padding band.

                                     The hit target is the Processes table's Button.chev idiom: Button.bare
                                     zeroes Padding and MinHeight, so left alone the button measures to the
                                     glyph and leaves a dead band above and below it. Stretch fills the
                                     header row; the negative margin then bleeds over the panel's padding,
                                     and is negative so it does NOT feed back into measure — a MinHeight
                                     would make every folding card taller instead. -->
                                <Button Grid.Column="0" x:Name="PART_Collapse" Classes="bare"
                                        AutomationProperties.Name="{TemplateBinding Title}"
                                        Width="22" Margin="0,-4,6,-4"
                                        VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                        IsVisible="{TemplateBinding Collapse,
                                                    Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock x:Name="PART_ChevronGlyph"/>
                                </Button>
                                <TextBlock Grid.Column="1" Classes="panelTitle"
                                           VerticalAlignment="Center"
                                           Text="{TemplateBinding Title}"
                                           IsVisible="{TemplateBinding Title,
                                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center"
                                                  Content="{TemplateBinding HeaderLead}"
                                                  IsVisible="{TemplateBinding HeaderLead,
                                                              Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                <ContentPresenter Grid.Column="3" VerticalAlignment="Center"
                                                  HorizontalAlignment="Right"
                                                  Content="{TemplateBinding HeaderContent}"
                                                  IsVisible="{TemplateBinding HeaderContent,
                                                              Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            </Grid>
                            <TextBlock Classes="cardSub" Text="{TemplateBinding Subtitle}"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{TemplateBinding Subtitle,
                                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        <ContentPresenter x:Name="PART_Body"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Picked up: lifted above its neighbours and accented, so the gap it left reads as the target. -->
    <Style Selector="controls|WidgetPanel.dragging">
        <Setter Property="Opacity" Value="0.92"/>
    </Style>
    <Style Selector="controls|WidgetPanel.dragging /template/ Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="BoxShadow" Value="{StaticResource ShadowDrag}"/>
    </Style>

    <!-- The same, for a plain surface dragged out of a strip: those are cards rather than widgets,
         so they have no template to reach into. -->
    <Style Selector="Border.panel.dragging, Border.card.dragging">
        <Setter Property="Opacity" Value="0.92"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="BoxShadow" Value="{StaticResource ShadowDrag}"/>
    </Style>

    <!-- Hit-testable so a press on the empty part of the header still reaches the board. The drag
         cursor is NOT set here: a style cannot tell whether this panel sits in a WidgetBoard, and one
         that said Hand on every header advertised a drag on the three tabs that have no board.
         WidgetBoard sets it from the same predicate that starts a drag. -->
    <Style Selector="controls|WidgetPanel /template/ StackPanel#PART_Header">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- WidgetTable: header above a body that scrolls, both inset by the same scrollbar gutter. -->
    <Style Selector="controls|WidgetTable">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel LastChildFill="True">
                    <ContentPresenter x:Name="PART_TableHeader" DockPanel.Dock="Top"
                                      Content="{TemplateBinding Header}"
                                      Margin="{TemplateBinding Gutter}"/>
                    <ScrollViewer x:Name="PART_BodyScroll" MaxHeight="{TemplateBinding MaxBodyHeight}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="{TemplateBinding BodyScrollBars}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="{TemplateBinding Gutter}"/>
                    </ScrollViewer>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Folded shut. The glyph is the app's own disclosure pair, the one the Processes group headers
         draw, set from the pseudo-class so nothing has to select it in code. Only the BODY is hidden —
         hiding the panel itself would drop it out of a board's visible children and change what a drop
         index means. -->
    <Style Selector="controls|WidgetPanel /template/ TextBlock#PART_ChevronGlyph">
        <!-- 12.5, not the Processes table's 9: that one is read against a 12.5 row, this against a
             13.5 SemiBold panel title, where anything under about 12 reads as a dot rather than a
             chevron. -->
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="Text" Value="&#x25BE;"/>
    </Style>
    <Style Selector="controls|WidgetPanel /template/ Button#PART_Collapse:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="controls|WidgetPanel:collapsed /template/ TextBlock#PART_ChevronGlyph">
        <Setter Property="Text" Value="&#x25B8;"/>
    </Style>
    <Style Selector="controls|WidgetPanel:collapsed /template/ ContentPresenter#PART_Body">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <!-- Same trick as .headless below: with no body, the header's bottom margin is a dangling gap. -->
    <Style Selector="controls|WidgetPanel:collapsed /template/ StackPanel#PART_Header">
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- A widget with no heading at all: drop the header's bottom margin so the body starts at the
         panel's own padding rather than 10px below it. -->
    <Style Selector="controls|WidgetPanel.headless /template/ StackPanel#PART_Header">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="IsVisible" Value="False"/>
    </Style>
</Styles>
