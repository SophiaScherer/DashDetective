<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Reusable styling for DashDetective. Applied app-wide via a class name
      (e.g. <Border Classes="panel"/>). Tabs and widgets share these so the look
      stays consistent and is defined once.
    -->

    <!-- ===== Surfaces ===== -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}"/>
        <Setter Property="Padding" Value="{StaticResource PanelPadding}"/>
    </Style>
    <!-- Draggable divider between resizable panes. Transparent grip that doubles as the
         inter-panel gap; subtle highlight on hover. -->
    <Style Selector="GridSplitter.paneSplitter">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="SizeWestEast"/>
    </Style>
    <Style Selector="GridSplitter.paneSplitter:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
    </Style>
    <!-- A card that is also a choice (the Performance resource list). Layered onto .card rather than
         restated as its own style: Performance's resCard was the same four surface setters at radius 8
         and padding 12,10, which is drift, not a different thing. Call sites write Classes="card
         selectable". No transition — a brush transition here animates the hover itself, so scrolling a
         list under a stationary pointer smears the highlight across every row it passes. -->
    <Style Selector="Border.card.selectable">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.card.selectable:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
    </Style>
    <Style Selector="Border.card.selectable.selected">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- ===== Reveal flash ===== -->
    <!-- The tint a row/card wears for a moment when something else in the app jumps to it (universal
         search, or the Performance tab naming a device). The transition lives here so the untint fades
         instead of blinking off; code-behind only adds and removes .highlighted, via RevealFlash.Flash.
         Four tabs had written this same pair by hand under four names (settingRow, adapterRow,
         driveCard, cmdRow's overlay). Where the flashed element also has a hover rule, the class goes on
         a separate non-hit-testable layer behind the content and the parent carries .highlighted — see
         the Toolkit tab; the shared .highlighted rule below is simply inert for that case. -->
    <Style Selector="Border.revealFlash">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.4"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.revealFlash.highlighted">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    </Style>

    <!-- ===== Typography ===== -->
    <Style Selector="TextBlock.panelTitle">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.cardLabel">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    </Style>
    <Style Selector="TextBlock.cardValue">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="TextBlock.cardUnit">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    </Style>
    <Style Selector="TextBlock.cardSub">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSubtle}"/>
    </Style>

    <!-- A small readout inside a card: muted label over a larger value. Sits below cardValue (26), which
         is a headline figure. Performance drew 11/17 and Storage 12/16 for the same tile, so both now
         read at one size; Processes' 22pt summary figure is a genuinely different scale and stays local
         to that tab until a second one wants it. -->
    <Style Selector="TextBlock.tileLabel">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    </Style>
    <Style Selector="TextBlock.tileValue">
        <Setter Property="FontSize" Value="16.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
    </Style>

    <!-- Chart key entry (used by the ChartLegend widget). Matches cardSub, so a legend reads as part of
         the chart's caption line rather than as another readout. -->
    <Style Selector="TextBlock.legendLabel">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSubtle}"/>
    </Style>

    <!-- Uppercase muted column header for a table (File Explorer, Network, Processes, Storage). Where
         the column sorts, .active tints the label and its ↑/↓ arrow to the accent; a non-sorting table
         simply never sets the class. The four tabs had drifted to three variants (10.5pt vs 11pt,
         TextSubtle vs TextMuted) while rendering the same thing, so the header row now reads the same
         on every tab. -->
    <Style Selector="TextBlock.colHead">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    </Style>
    <Style Selector="TextBlock.colHead.active">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="TextBlock.sortArrow">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- ===== Key/value rows (used by the InfoRow widget) ===== -->
    <Style Selector="Border.infoRow">
        <Setter Property="BorderBrush" Value="{DynamicResource RowLine}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,7"/>
    </Style>
    <Style Selector="Border.infoRow TextBlock.infoKey">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    </Style>
    <Style Selector="Border.infoRow TextBlock.infoVal">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Path values (ExpandablePathRow) read left-to-right, so left-align instead of the
         right-aligned default above. Declared after infoVal so it wins the tie. -->
    <Style Selector="Border.infoRow TextBlock.pathVal">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>
    <!-- InfoRow variants, set as classes on the control itself (Classes="mono flush"). Declared after
         the rules above so they win the tie. mono: addresses and IDs read better column-aligned, which
         is what the Network tab's IP Configuration wanted. flush: drops the divider, for a list that
         reads as one block rather than a table of rows. -->
    <Style Selector="Border.infoRow.mono TextBlock.infoVal">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="Border.infoRow.flush">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <!-- Chrome-less toggle for the path row: the "…" affordance and the expanded click target.
         Accent-tinted, no button box, so it reads as inline text rather than a control. -->
    <Style Selector="Border.infoRow Button.pathToggle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.infoRow Button.pathToggle /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.infoRow Button.pathToggle:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AccentHover}"/>
    </Style>

    <!-- ===== Bare button ===== -->
    <!-- Strips a Button back to a click target with no chrome of its own, so the content inside it (a
         segment, a selectable card) carries the whole appearance. The partner of the selectable-card and
         segmented-selector styles below. -->
    <Style Selector="Button.bare">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.bare /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ===== Segmented selector ===== -->
    <Style Selector="Border.segments">
        <Setter Property="Background" Value="{DynamicResource FieldBackground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSegment}"/>
        <Setter Property="Padding" Value="3"/>
    </Style>
    <Style Selector="Border.seg">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Padding" Value="14,6"/>
    </Style>
    <Style Selector="Border.seg.selected">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Border.seg TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="Border.seg.selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    </Style>

    <!-- ===== Pill toggle ===== -->
    <!-- A real ToggleButton templated to the design comp's pill: a 40×22 rounded track (grey off,
         accent on) with a 16 px thumb that slides left↔right. Two-way bindable via IsChecked, so it
         replaces the old decorative Border toggles while keeping the exact look. -->
    <Style Selector="ToggleButton.toggle">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Track" Background="{DynamicResource TrackOff}" CornerRadius="11">
                    <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource TextStrong}"
                             HorizontalAlignment="Left" Margin="3,0,0,0"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.toggle:checked /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="ToggleButton.toggle:checked /template/ Ellipse#Thumb">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
    </Style>

    <!-- ===== Action buttons ===== -->
    <Style Selector="Button.action">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusField}"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverOverlayStrong}"/>
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
    </Style>

    <!-- A cross-reference to somewhere else in the app: accent text plus a small arrow, no button chrome.
         Used by the Performance detail header to jump to the tab that owns the selected device. Sized to
         sit on a panelTitle line without lifting it. The arrow is drawn by the caller, as the repo's other
         glyphs are; this styles the frame and colours both through Foreground. -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusHair}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
    </Style>
    <Style Selector="Button.link:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AccentHover}"/>
    </Style>
    <!-- Strokes follow the button's Foreground, so the hover recolour reaches the arrow too. -->
    <Style Selector="Button.link Path.linkArrow">
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
    </Style>

    <!-- ===== Search / path fields ===== -->
    <!-- The bordered surface a bound text input sits in (the Ping/DNS targets, the Toolkit "Add
         command" form). The same four chrome setters were also written by hand at seven more call
         sites; those keep their local geometry but should draw this surface. Height is 32 — Network
         drew 30 and Toolkit 32 for the same control. -->
    <Style Selector="Border.field">
        <Setter Property="Background" Value="{DynamicResource FieldBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusField}"/>
        <Setter Property="Height" Value="{StaticResource FieldHeight}"/>
    </Style>
    <!-- Padding rather than Margin for the 9px inset, so the whole field width is a click target
         instead of leaving a dead zone down each side. -->
    <Style Selector="Border.field TextBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="9,0"/>
    </Style>

    <!-- A TextBox that draws no chrome of its own, for boxes sitting inside a styled field Border
         (the toolbar search, the process filter, the File Explorer path bar). Fluent otherwise paints
         a solid background and an accent underline on focus, which fills the rounded field with a
         square black block and overhangs its corners. The states are listed explicitly because the
         theme's own :pointerover / :focus rules would otherwise win. -->
    <Style Selector="TextBox.flat /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.flat:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.flat:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- The × that empties one of those fields (the process filter, the toolbar search). Chrome-less
         so only the glyph reads against the field it sits inside. -->
    <Style Selector="Button.clearField">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusHair}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.clearField:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
    </Style>

    <!-- ===== Scrollbars ===== -->
    <!-- Fluent's default scrollbars auto-hide: a thin line that expands on hover as an overlay ON TOP
         of content. Pin auto-hide off app-wide so a present bar stays solid and stable rather than
         fading in and out over the content. Fluent lays content out UNDERNEATH the bar, so lists keep
         a right gutter (row/header padding) that the bar sits in; flush lists add that padding locally
         (see the Network Adapters/Connections rows) rather than via the ScrollViewer, which would also
         shift a sticky header out of alignment with its rows. -->
    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>
</Styles>
