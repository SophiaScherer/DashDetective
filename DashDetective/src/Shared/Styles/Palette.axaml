<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Central colour palette for DashDetective. Every colour in the app is defined here, once.

      Three groups of keys:
      • Series — the per-graph colours. Overwritten at runtime by ThemeService when an accent is
        chosen, so views must reference them with {DynamicResource ...}.
      • Semantic — the fixed hues, their status aliases and their tints. These deliberately do NOT
        follow the accent: a "Running" process should not turn orange because the accent did.
        {StaticResource} is correct for them. Code that needs them as brushes reads the C# mirror,
        Services/Theming/SemanticBrushes.cs.
      • Surface (ThemeDictionaries) — surfaces, lines and the text ramp. These flip with the app's
        ThemeVariant (Light/Dark), so views must reference them with {DynamicResource}.

      Each hue is declared once as a <Color> primitive and every brush derives from it, so a colour has
      a single definition however many tints hang off it.
    -->

    <!-- ===== Colour primitives =====
         The authored hues. Nothing outside this file should spell a hex literal. -->
    <Color x:Key="BlueColor">#4cc2ff</Color>
    <Color x:Key="PurpleColor">#c58fff</Color>
    <Color x:Key="GreenColor">#6ccb5f</Color>
    <Color x:Key="YellowColor">#ffcf4d</Color>
    <Color x:Key="OrangeColor">#ff8a5c</Color>
    <Color x:Key="RedColor">#ff6b6b</Color>
    <Color x:Key="PinkColor">#ff7ac6</Color>
    <Color x:Key="NeutralColor">#9aa0a6</Color>
    <!-- Black, for the shadow and scrim tints below. Fixed in both themes: a dimmed window reads as
         dimmed either way. -->
    <Color x:Key="ShadeColor">#000000</Color>

    <!-- ===== Theme-invariant: fixed accent-legend colours =====
         Used by the "Default" swatch's 2x2 legend and as the default per-graph chart colours below.
         Fixed, so a running accent swap never changes them. -->
    <SolidColorBrush x:Key="Blue" Color="{StaticResource BlueColor}"/>
    <SolidColorBrush x:Key="Purple" Color="{StaticResource PurpleColor}"/>
    <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="Yellow" Color="{StaticResource YellowColor}"/>
    <SolidColorBrush x:Key="Orange" Color="{StaticResource OrangeColor}"/>
    <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}"/>
    <SolidColorBrush x:Key="Pink" Color="{StaticResource PinkColor}"/>
    <SolidColorBrush x:Key="Neutral" Color="{StaticResource NeutralColor}"/>

    <!-- ===== Semantic: status =====
         What a dot, badge or health figure means, named by meaning rather than by hue. Aliases of the
         fixed colours above, so a status never drifts from the legend it is read against. -->
    <SolidColorBrush x:Key="StatusGood" Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="StatusWarn" Color="{StaticResource YellowColor}"/>
    <SolidColorBrush x:Key="StatusBad" Color="{StaticResource RedColor}"/>
    <SolidColorBrush x:Key="StatusInfo" Color="{StaticResource BlueColor}"/>
    <SolidColorBrush x:Key="StatusIdle" Color="{StaticResource NeutralColor}"/>

    <!-- ===== Semantic: soft fills =====
         The tint behind an icon tile or badge. One alpha for all of them — the two that had drifted
         apart, 14% and 16%, are now both 16% — so tinted surfaces read as one family across tabs. -->
    <SolidColorBrush x:Key="BlueSoft" Color="{StaticResource BlueColor}" Opacity="0.16"/>
    <SolidColorBrush x:Key="PurpleSoft" Color="{StaticResource PurpleColor}" Opacity="0.16"/>
    <SolidColorBrush x:Key="GreenSoft" Color="{StaticResource GreenColor}" Opacity="0.16"/>
    <SolidColorBrush x:Key="YellowSoft" Color="{StaticResource YellowColor}" Opacity="0.16"/>
    <SolidColorBrush x:Key="OrangeSoft" Color="{StaticResource OrangeColor}" Opacity="0.16"/>
    <SolidColorBrush x:Key="RedSoft" Color="{StaticResource RedColor}" Opacity="0.16"/>
    <SolidColorBrush x:Key="PinkSoft" Color="{StaticResource PinkColor}" Opacity="0.16"/>

    <!-- Outlines for those fills, and the hover step above each. Only the destructive (red) and the
         alert (yellow) surfaces are interactive today, so only they carry the full ladder. -->
    <SolidColorBrush x:Key="RedSoftHover" Color="{StaticResource RedColor}" Opacity="0.24"/>
    <SolidColorBrush x:Key="RedLine" Color="{StaticResource RedColor}" Opacity="0.30"/>
    <SolidColorBrush x:Key="RedLineHover" Color="{StaticResource RedColor}" Opacity="0.40"/>
    <SolidColorBrush x:Key="YellowLine" Color="{StaticResource YellowColor}" Opacity="0.30"/>
    <SolidColorBrush x:Key="GreenLine" Color="{StaticResource GreenColor}" Opacity="0.30"/>

    <!-- ===== Semantic: elevation =====
         Three roles, replacing five ad-hoc alphas. A popup sits just off the surface; a dragged item
         and a modal sit well above it. Fixed in both themes, like the scrim. -->
    <BoxShadows x:Key="ShadowPopup">0 8 24 0 #22000000</BoxShadows>
    <BoxShadows x:Key="ShadowDrag">0 8 24 0 #55000000</BoxShadows>
    <BoxShadows x:Key="ShadowModal">0 12 40 0 #55000000</BoxShadows>

    <!-- The full-window dim behind a modal. Black at 55% in BOTH themes. A non-null Background is also
         what makes a modal modal — it swallows pointer input bound for the window behind it. -->
    <SolidColorBrush x:Key="ScrimBackground" Color="{StaticResource ShadeColor}" Opacity="0.55"/>

    <!-- ===== Theme-invariant: accent set (swapped at runtime by ThemeService) ===== -->
    <SolidColorBrush x:Key="Accent" Color="{StaticResource BlueColor}"/>
    <SolidColorBrush x:Key="AccentHover" Color="#66d0ff"/>
    <SolidColorBrush x:Key="OnAccent" Color="#06263a"/>
    <!-- 12%, not the 16% of the soft fills above: this one sits behind body text, where a stronger
         fill costs contrast. -->
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource BlueColor}" Opacity="0.12"/>
    <!-- Colours (not brushes) for the brand-logo gradient stops. -->
    <Color x:Key="AccentColor">#4cc2ff</Color>
    <Color x:Key="AccentDeep">#2a7fd4</Color>

    <!-- ===== Theme-invariant: chart series (swapped at runtime by ThemeService) =====
         Each dashboard graph binds to one of these. In the "Default" look they hold the distinct
         colours below; when a single accent is chosen, ThemeService re-hues them around it. -->
    <SolidColorBrush x:Key="ChartCpu" Color="{StaticResource BlueColor}"/>
    <SolidColorBrush x:Key="ChartMemory" Color="{StaticResource PurpleColor}"/>
    <SolidColorBrush x:Key="ChartGpu" Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="ChartStorage" Color="{StaticResource YellowColor}"/>
    <SolidColorBrush x:Key="ChartNetDown" Color="{StaticResource BlueColor}"/>
    <SolidColorBrush x:Key="ChartNetUp" Color="{StaticResource OrangeColor}"/>
    <!-- Not a graph, but it sits beside the CPU and memory figures on the Processes summary strip, so it
         re-hues with them. Pink keeps it clear of GPU's green. -->
    <SolidColorBrush x:Key="ChartThreads" Color="{StaticResource PinkColor}"/>

    <!-- ===== Theme-invariant: console surface =====
         The terminal look shared by the Network tab's ping/DNS output and the Toolkit tab's command
         output and execution log. Two features draw it, so it lives here rather than being declared
         twice. ConsoleBg stays dark in BOTH themes: the text colours below are fixed, and a light
         inset would wash them out. That is also why these do not follow the theme ramp or the accent.
         Fixed, so {StaticResource} is the correct binding for them. -->
    <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,Courier New,monospace</FontFamily>
    <SolidColorBrush x:Key="ConsoleBg" Color="#111318"/>
    <SolidColorBrush x:Key="ConsoleFg" Color="#c8ccd2"/>
    <SolidColorBrush x:Key="ConsoleMuted" Color="#8b9099"/>
    <SolidColorBrush x:Key="ConsoleGreen" Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="ConsoleBlue" Color="{StaticResource BlueColor}"/>

    <ResourceDictionary.ThemeDictionaries>

        <!-- ===================== DARK ===================== -->
        <ResourceDictionary x:Key="Dark">
            <!-- Surfaces -->
            <SolidColorBrush x:Key="AppBackground" Color="#141414"/>
            <SolidColorBrush x:Key="SidebarBackground" Color="#1b1b1b"/>
            <SolidColorBrush x:Key="PanelBackground" Color="#1c1c1c"/>
            <SolidColorBrush x:Key="CardBackground" Color="#212121"/>
            <SolidColorBrush x:Key="FieldBackground" Color="#141414"/>

            <!-- Lines & tracks -->
            <SolidColorBrush x:Key="Hairline" Color="#FFFFFF" Opacity="0.06"/>
            <SolidColorBrush x:Key="RowLine" Color="#FFFFFF" Opacity="0.05"/>
            <SolidColorBrush x:Key="TrackOff" Color="#FFFFFF" Opacity="0.16"/>
            <!-- Faint lattice drawn behind the larger utilization charts (matches the design's rgba(255,255,255,0.055)). -->
            <SolidColorBrush x:Key="ChartGrid" Color="#FFFFFF" Opacity="0.055"/>

            <!-- Hover overlays (for icon buttons / faint fills) -->
            <SolidColorBrush x:Key="HoverOverlay" Color="#FFFFFF" Opacity="0.07"/>
            <SolidColorBrush x:Key="HoverOverlayStrong" Color="#FFFFFF" Opacity="0.12"/>

            <!-- Text (decreasing emphasis) -->
            <SolidColorBrush x:Key="TextStrong" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" Opacity="0.90"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#FFFFFF" Opacity="0.72"/>
            <SolidColorBrush x:Key="TextTertiary" Color="#FFFFFF" Opacity="0.62"/>
            <SolidColorBrush x:Key="TextMuted" Color="#FFFFFF" Opacity="0.50"/>
            <SolidColorBrush x:Key="TextSubtle" Color="#FFFFFF" Opacity="0.45"/>
            <SolidColorBrush x:Key="TextFaint" Color="#FFFFFF" Opacity="0.35"/>
            <!-- Ghosted completion text. Fainter than TextFaint on purpose: it sits directly beside
                 what the user is typing, so it has to read as a suggestion rather than as input. -->
            <SolidColorBrush x:Key="TextGhost" Color="#FFFFFF" Opacity="0.18"/>
        </ResourceDictionary>

        <!-- ===================== LIGHT ===================== -->
        <ResourceDictionary x:Key="Light">
            <!-- Surfaces (light greys; panels/cards raised to white) -->
            <SolidColorBrush x:Key="AppBackground" Color="#eef0f2"/>
            <SolidColorBrush x:Key="SidebarBackground" Color="#f7f8fa"/>
            <SolidColorBrush x:Key="PanelBackground" Color="#ffffff"/>
            <SolidColorBrush x:Key="CardBackground" Color="#ffffff"/>
            <SolidColorBrush x:Key="FieldBackground" Color="#eceef1"/>

            <!-- Lines & tracks -->
            <SolidColorBrush x:Key="Hairline" Color="#000000" Opacity="0.10"/>
            <SolidColorBrush x:Key="RowLine" Color="#000000" Opacity="0.08"/>
            <SolidColorBrush x:Key="TrackOff" Color="#000000" Opacity="0.20"/>
            <!-- Faint lattice drawn behind the larger utilization charts (dark's white 5.5% mirrored to a matching faint black). -->
            <SolidColorBrush x:Key="ChartGrid" Color="#000000" Opacity="0.08"/>

            <!-- Hover overlays -->
            <SolidColorBrush x:Key="HoverOverlay" Color="#000000" Opacity="0.05"/>
            <SolidColorBrush x:Key="HoverOverlayStrong" Color="#000000" Opacity="0.09"/>

            <!-- Text (decreasing emphasis) -->
            <SolidColorBrush x:Key="TextStrong" Color="#000000" Opacity="0.95"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#000000" Opacity="0.88"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#000000" Opacity="0.70"/>
            <SolidColorBrush x:Key="TextTertiary" Color="#000000" Opacity="0.60"/>
            <SolidColorBrush x:Key="TextMuted" Color="#000000" Opacity="0.50"/>
            <SolidColorBrush x:Key="TextSubtle" Color="#000000" Opacity="0.45"/>
            <SolidColorBrush x:Key="TextFaint" Color="#000000" Opacity="0.35"/>
            <!-- See the dark theme's note; a touch stronger, as dark-on-light reads fainter. -->
            <SolidColorBrush x:Key="TextGhost" Color="#000000" Opacity="0.22"/>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
