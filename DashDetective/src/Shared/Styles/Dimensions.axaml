<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
    <!-- Layout dimensions: spacings, insets, radii, control heights. Theme-invariant, so unlike
         Palette.axaml's brushes these are always consumed with {StaticResource} — with the two
         exceptions in the UI scale section at the bottom. -->

    <!-- ===== Spacing ===== -->
    <!-- The gap between widgets, and the gap between a page's sections. -->
    <sys:Double x:Key="SpacePage">16</sys:Double>

    <!-- ===== Insets ===== -->
    <!-- PageInset is the shell's content margin, deeper at the bottom so a scrolled page ends on a gap. -->
    <Thickness x:Key="PageInset">22,20,22,30</Thickness>
    <Thickness x:Key="PanelPadding">16</Thickness>
    <Thickness x:Key="CardPadding">13,12</Thickness>
    <!-- ScrollGutter keeps a scroller's content off its vertical bar. A Margin on the content, never
         ScrollViewer Padding, which the scroll extent leaves out. -->
    <Thickness x:Key="ScrollGutter">0,0,14,0</Thickness>

    <!-- ===== Corner radii ===== -->
    <!-- Largest surface to smallest affordance. -->
    <CornerRadius x:Key="RadiusPanel">9</CornerRadius>
    <CornerRadius x:Key="RadiusSegment">7</CornerRadius>
    <CornerRadius x:Key="RadiusField">6</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">5</CornerRadius>
    <CornerRadius x:Key="RadiusHair">4</CornerRadius>

    <!-- ===== Icon sizes ===== -->
    <!-- Two, because the app needs two: IconSize is an icon that identifies something (a file, a page,
         a command, a search result) or fills a chrome button; IconSizeSmall is a glyph inside a row-level
         button, a field or a tinted tile. The nav geometries are authored on an 18x18 grid whose ink fills
         about 78% of it, so a site takes Stretch="Uniform" — with "None" the box grows and the ink does
         not. Marks that are deliberately smaller than either (a clear X, a status dot, a drag grip) stay
         literals: they are not icons. -->
    <sys:Double x:Key="IconSize">18</sys:Double>
    <sys:Double x:Key="IconSizeSmall">16</sys:Double>

    <!-- ===== Widget and table metrics ===== -->
    <Thickness x:Key="WidgetHeaderMargin">0,0,0,10</Thickness>
    <sys:Double x:Key="FieldHeight">32</sys:Double>
    <sys:Double x:Key="TableRowHeight">30</sys:Double>

    <!-- ===== Runtime-swapped values (rewritten by ThemeService) =====
         The only keys here that change while the app runs, so the only ones needing {DynamicResource}.
         ChartPatterns is not a dimension; it sits here because Palette.axaml is color only and a third
         file for one bool would be worse. -->
    <sys:Double x:Key="UiScale">1</sys:Double>
    <sys:Double x:Key="PopupFontSize">14</sys:Double>
    <sys:Boolean x:Key="ChartPatterns">False</sys:Boolean>

    <!-- The type ladder, smallest to largest, declared in ascending order and kept strictly increasing.
         Every FontSize in the app comes from here, so text scale is one rewrite of these keys. Values
         mirror TextScale.BaseSizes; a test pins them together. -->
    <sys:Double x:Key="TextSizeMicro">11</sys:Double>
    <sys:Double x:Key="TextSizeMini">11.5</sys:Double>
    <sys:Double x:Key="TextSizeCaption">12</sys:Double>
    <sys:Double x:Key="TextSizeSmall">12.5</sys:Double>
    <sys:Double x:Key="TextSizeCompact">13</sys:Double>
    <sys:Double x:Key="TextSizeBody">14</sys:Double>
    <sys:Double x:Key="TextSizeMedium">14.5</sys:Double>
    <sys:Double x:Key="TextSizeSubhead">15</sys:Double>
    <sys:Double x:Key="TextSizeTitle">15.5</sys:Double>
    <sys:Double x:Key="TextSizeTitleLarge">16.5</sys:Double>
    <sys:Double x:Key="TextSizeHeading">17.5</sys:Double>
    <sys:Double x:Key="TextSizeHeadingLarge">18</sys:Double>
    <sys:Double x:Key="TextSizeDisplay">20</sys:Double>
    <sys:Double x:Key="TextSizeDisplayLarge">24</sys:Double>
    <sys:Double x:Key="TextSizeHero">28.5</sys:Double>
</ResourceDictionary>
