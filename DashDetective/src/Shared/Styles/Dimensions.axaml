<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
    <!-- Layout dimensions: spacings, insets, radii, control heights. Theme-invariant, so unlike
         Palette.axaml's brushes these are always consumed with {StaticResource}. -->

    <!-- ===== Spacing ===== -->
    <!-- SpacePage separates widgets; the rest are rhythms inside one. -->
    <sys:Double x:Key="SpaceHair">4</sys:Double>
    <sys:Double x:Key="SpaceTight">8</sys:Double>
    <sys:Double x:Key="SpaceSnug">10</sys:Double>
    <sys:Double x:Key="SpacePanel">12</sys:Double>
    <sys:Double x:Key="SpacePage">16</sys:Double>

    <!-- ===== Insets ===== -->
    <!-- PageInset is the shell's content margin, deeper at the bottom so a scrolled page ends on a gap. -->
    <Thickness x:Key="PageInset">22,20,22,30</Thickness>
    <Thickness x:Key="PanelPadding">16</Thickness>
    <Thickness x:Key="CardPadding">13,12</Thickness>

    <!-- ===== Corner radii ===== -->
    <!-- Largest surface to smallest affordance. -->
    <CornerRadius x:Key="RadiusPanel">9</CornerRadius>
    <CornerRadius x:Key="RadiusSegment">7</CornerRadius>
    <CornerRadius x:Key="RadiusField">6</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">5</CornerRadius>
    <CornerRadius x:Key="RadiusHair">4</CornerRadius>

    <!-- ===== Widget and table metrics ===== -->
    <!-- TableGutter is the right inset a table's header and rows share, so the scrollbar sits beside
         the content rather than over it. Both must use the one value or the columns misalign. -->
    <Thickness x:Key="WidgetHeaderMargin">0,0,0,10</Thickness>
    <sys:Double x:Key="WidgetGutter">16</sys:Double>
    <sys:Double x:Key="TableGutter">14</sys:Double>
    <sys:Double x:Key="FieldHeight">32</sys:Double>
    <sys:Double x:Key="TableRowHeight">30</sys:Double>
</ResourceDictionary>
