<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DashDetective.Shared.Controls"
             x:Class="DashDetective.Shared.Controls.StatCard"
             x:Name="Root" x:CompileBindings="False">
    <!-- A dashboard metric card: label, colour dot, big value + unit, caption, sparkline. -->
    <!-- Selectable is opt-in: it adds the shared card.selectable hover + hand cursor for a card that is
         also a click target, and leaves a plain readout alone. -->
    <Border Classes="card" Classes.selectable="{Binding #Root.Selectable}">
        <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="cardLabel" Text="{Binding #Root.Label}"/>
                <Rectangle Grid.Column="1" Width="8" Height="8" RadiusX="2" RadiusY="2"
                           Fill="{Binding #Root.Accent}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="cardValue" Text="{Binding #Root.Value}"/>
                <TextBlock Classes="cardUnit" Text="{Binding #Root.Unit}"
                           VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            </StackPanel>
            <TextBlock Classes="cardSub" Text="{Binding #Root.Sub}"/>
            <!-- Gradient fill and lattice on the same scale as the larger charts. The grid is a scale,
                 not decoration — its bands are quarters of the axis — so a card that ruled itself into
                 halves would be marking different values than the panel chart beside it.

                 The axis is labelled at its ends only, and carries no time range: a card chart is about a
                 third the height of a panel one, so a third label would crowd the two that matter and a
                 footer would take most of what is left to draw in. Every card covers the same window as the
                 panel charts below them, which state it. -->
            <controls:Sparkline Classes="chartMini" StrokeThickness="1.4" Fill="True" ShowGrid="True"
                                Stroke="{Binding #Root.Accent}" Points="{Binding #Root.Points}"
                                YMin="{Binding #Root.YMin}" YMax="{Binding #Root.YMax}"
                                AxisMaxLabel="{Binding #Root.AxisMaxLabel}"
                                AxisMinLabel="{Binding #Root.AxisMinLabel}"/>
        </StackPanel>
    </Border>
</UserControl>
