<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DashDetective.Shared.Controls"
             xmlns:nav="using:DashDetective.Shell.Navigation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="236" d:DesignHeight="760"
             x:Class="DashDetective.Shell.Navigation.NavigationView"
             x:DataType="nav:NavigationViewModel">

    <UserControl.Styles>
        <!-- Sidebar nav rows. Selection-driven visuals are all sourced from theme/accent resources
             so they follow the current theme and accent. Defaults are the unselected, expanded,
             vertical state; the `.collapsed` and `.horizontal` classes on the root `Border.rail`
             layer on the overrides. Anything that changes with state is set through styles (not
             inline) so the more specific setter wins. -->
        <!-- Strip default button chrome for the nav rows. -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Motion. The rail is the one place in this app that animates, and only for its own two moves:
             a collapse that snaps 236px to 64px and a bar that teleports between window edges both read as
             glitches rather than gestures. Only a vertical rail tweens its size: RailWidth is NaN on a
             horizontal bar, whose height follows its content, and NaN is not worth interpolating. A dock
             change cannot be tweened at all (a DockPanel offers no path between edges), so it fades
             instead: out, relayout while invisible, back in. Both live on the rail Border, which carries no
             :pointerover of its own. -->
        <Style Selector="Border.rail:not(.horizontal)">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.rail.horizontal">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Nav row surface + selection highlight. -->
        <Style Selector="Border.rail Border.navRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="11,9"/>
        </Style>
        <Style Selector="Button.nav.selected Border.navRow">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>

        <!-- Accent indicator: a vertical leading bar on a vertical rail; a bottom underline on a
             horizontal bar. Only one is shown, and only when the row is selected. -->
        <Style Selector="Border.rail Rectangle.navIndicator">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Button.nav.selected Rectangle.navIndicator">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="Border.rail Rectangle.navIndicatorH">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Border.rail.horizontal Button.nav.selected Rectangle.navIndicator">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Border.rail.horizontal Button.nav.selected Rectangle.navIndicatorH">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Icon + label colours. -->
        <Style Selector="Border.rail Path.navIcon">
            <Setter Property="Stroke" Value="{DynamicResource TextTertiary}"/>
        </Style>
        <Style Selector="Button.nav.selected Path.navIcon">
            <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Border.rail TextBlock.navLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style Selector="Button.nav.selected TextBlock.navLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Default (expanded, vertical) layout: icon+label pushed clear of the leading indicator. -->
        <Style Selector="Border.rail StackPanel.navContent">
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- The brand area stretches so the whole strip is a drag handle; the logo and wordmark inside
             it stay left-aligned. -->
        <Style Selector="Border.rail Panel.brand">
            <Setter Property="Margin" Value="18,16,18,14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Border.rail StackPanel.brandMark">
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Collapsed (icons-only) overrides. -->
        <Style Selector="Border.rail.collapsed TextBlock.navLabel">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Border.rail.collapsed Border.navRow">
            <Setter Property="Padding" Value="0,9"/>
        </Style>
        <Style Selector="Border.rail.collapsed StackPanel.navContent">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.rail.collapsed Panel.brand">
            <Setter Property="Margin" Value="0,16,0,14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.rail.collapsed StackPanel.brandMark">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Horizontal (top/bottom) overrides: items flow sideways, icon+label centred, logo-only
             brand, and the row spacing is symmetric. -->
        <Style Selector="Border.rail.horizontal Border.navRow">
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style Selector="Border.rail.horizontal StackPanel.navContent">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.rail.horizontal Panel.brand">
            <Setter Property="Margin" Value="14,0,10,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Footer separator sits on the edge facing the content. A horizontal bar is as tall as its
             tallest part, so its footer keeps to the item rows' height rather than setting its own. -->
        <Style Selector="Border.rail Border.footer">
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style Selector="Border.rail.horizontal Border.footer">
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>

        <!-- On-bar control buttons: the collapse toggle beside the logo, and the Help + orientation
             pair in the footer. -->
        <Style Selector="Button.navCtl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.navCtl:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        </Style>
        <!-- Chrome-less wrapper for the dock menu's rows. -->
        <Style Selector="Button.pickTile">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.pickTile /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Little "panel on this edge" preview beside each dock menu row. -->
        <Style Selector="Border.posTile">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource FieldBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.posTile.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>

        <!-- Right-click dock menu: one row per edge, the current one highlighted. Selection is declared
             after hover so an already-docked row keeps reading as selected while the pointer is on it. -->
        <Style Selector="TextBlock.dockMenuHeader">
            <Setter Property="FontSize" Value="{DynamicResource TextSizeMini}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}"/>
            <Setter Property="Margin" Value="8,4,8,2"/>
        </Style>
        <Style Selector="Border.dockRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="Button.pickTile:pointerover Border.dockRow">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        </Style>
        <Style Selector="Border.dockRow.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>
        <Style Selector="Border.dockRow TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource TextSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.dockRow.selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
        </Style>

        <!-- Collapse/expand puck: a semi-circle domed into the bar with its flat side flush on the
             content-facing edge, revealed while the pointer is over the bar and for a grace period after
             it leaves (NavigationViewModel.PointerEnteredBar/PointerExitedBar) — a bare :pointerover rule
             snatched it away the moment the pointer wobbled off the rail. A chrome-less button wrapping a
             styled Border, the same split as the dock menu's `pickTile`/`posTile` pair. -->
        <Style Selector="Button.railChevron">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.railChevron /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Raised one step off the rail's own surface so it reads as sitting on the edge, in both themes. -->
        <Style Selector="Border.puck">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Panel.railHost Path.chevronGlyph">
            <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <!-- Hover picks up the accent rather than a fill overlay: the puck is opaque, so a translucent
             overlay would let the content behind it show through. -->
        <Style Selector="Button.railChevron:pointerover Border.puck">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Button.railChevron:pointerover Path.chevronGlyph">
            <Setter Property="Fill" Value="{DynamicResource Accent}"/>
        </Style>

        <!-- Section caret: a cue on the current page's item that pressing it again lists the page's
             sections. A glyph, not a second button, so the row stays one tab stop and one hit target. It
             overlays the row's padding rather than joining its content, so showing it never moves a
             neighbor: at the trailing end of an expanded vertical row, under the icon on a collapsed rail,
             and in the trailing padding of a horizontal bar's item. -->
        <Style Selector="Border.rail Path.sectionsCaret">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Fill" Value="{DynamicResource TextTertiary}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.rail.hasSections Button.nav.selected Path.sectionsCaret">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="Border.rail.collapsed Path.sectionsCaret">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,0,-7"/>
        </Style>
        <!-- After the collapsed rule, so a collapsed horizontal bar takes this one. -->
        <Style Selector="Border.rail.horizontal Path.sectionsCaret">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,-10,0"/>
        </Style>

        <!-- Drag-to-dock: dim the bar where it still sits so it reads as picked up, while the overlay's
             drop band previews the edge it will land on. The puck is kept out of a moving cursor's way by
             ShowChevron, not by a style — a setter cannot override the local IsVisible binding. -->
        <Style Selector="Panel.railHost.dragging Border.rail">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <!-- Declared after the drag dim so it wins the overlap: a dropped drag re-docks before EndDrag
             clears the dim, and the arriving bar must be fully out, not four-tenths in. Dropping the size
             transition for the duration is the other half: a dock change moves Width between a number and
             NaN, and NaN is not an endpoint worth interpolating from. The fade hides the relayout either way, so this
             is insurance rather than a fix for something visible. Opacity keeps its transition here, or
             there would be no fade at all. -->
        <Style Selector="Border.rail.relocating">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Declared here, not in SharedStyles: a local style outranks an app-level one whatever the
             selector says, so the rule undoing these transitions has to sit beside them. -->
        <Style Selector=":is(Window).reduceMotion Border.rail">
            <Setter Property="Transitions">
                <Transitions/>
            </Setter>
        </Style>
    </UserControl.Styles>

    <!-- ================= SIDEBAR ================= -->
    <!-- The rail plus its edge puck. The puck is a sibling of the rail, not a child, so its rounding and
         alignment are its own, but it now sits INSIDE the bar's bounds — domed inward from the
         content-facing edge. That is what makes it reliably clickable: reaching for it never leaves the
         rail, so the hover that reveals it cannot lapse on the way. It also means the view needs no
         ClipToBounds and the shell no ZIndex, both of which existed only to let it draw outside. -->
    <Panel x:Name="RailHost" Classes="railHost"
           Classes.dragging="{Binding IsDragging}"
           PointerEntered="OnRailPointerEntered" PointerExited="OnRailPointerExited">

    <!-- A vertical rail has a fixed width; a horizontal bar is as tall as its content. Either stretches
         along the docked edge. The inner DockPanel lays brand/toggle at the start, footer at the end, and
         the item list fills the middle, with the dock edges flipped for a horizontal bar. -->
    <Border x:Name="RailBorder"
            Classes="rail" Classes.collapsed="{Binding IsRailCollapsed}" Classes.horizontal="{Binding IsHorizontal}"
            Classes.relocating="{Binding IsRelocating}" Classes.hasSections="{Binding HasSections}"
            Width="{Binding RailWidth}"
            SizeChanged="OnRailSizeChanged"
            Background="{DynamicResource SidebarBackground}"
            BorderBrush="{DynamicResource Hairline}" BorderThickness="{Binding HairlineThickness}">

        <!-- Right-click anywhere on the bar to re-dock it. Declared once on the rail: ContextRequested
             bubbles, so the brand, the items, the footer and any empty space all reach it. Opens at the
             pointer, and reuses the same NavPositionOption list (and its preview tiles) as the Settings
             control, so all three re-dock paths stay in sync. -->
        <Border.ContextFlyout>
            <Flyout Placement="Pointer">
                <!-- A popup is its own visual root, so it carries the interface scale itself. -->
                <controls:ScaleHost Scale="{DynamicResource UiScale}">
                    <StackPanel Spacing="2" MinWidth="168" Margin="2">
                        <TextBlock Classes="dockMenuHeader" Text="DOCK NAVIGATION"/>
                        <ItemsControl ItemsSource="{Binding Positions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="nav:NavPositionOption">
                                    <Button Classes="pickTile" Command="{Binding SelectCommand}"
                                            Margin="0" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                                        <Border Classes="dockRow" Classes.selected="{Binding IsSelected}">
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <Border Classes="posTile" Classes.selected="{Binding IsSelected}">
                                                    <Panel Margin="3">
                                                        <Rectangle Fill="{DynamicResource Accent}"
                                                                   Width="{Binding BarWidth}" Height="{Binding BarHeight}"
                                                                   HorizontalAlignment="{Binding BarHAlign}"
                                                                   VerticalAlignment="{Binding BarVAlign}"
                                                                   RadiusX="1" RadiusY="1"/>
                                                    </Panel>
                                                </Border>
                                                <TextBlock Text="{Binding Label}"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </controls:ScaleHost>
            </Flyout>
        </Border.ContextFlyout>

        <DockPanel LastChildFill="True">

            <!-- Brand. Doubles as the drag handle: press and drag it to re-dock the bar to another
                 window edge (see NavigationView.axaml.cs). The wrapper stretches so the whole brand strip
                 is grabbable while the logo and wordmark inside it stay aligned to the leading edge; its
                 transparent background is what makes the empty part of the strip hit-testable. -->
            <Panel x:Name="BrandArea" Classes="brand" DockPanel.Dock="{Binding BrandDock}"
                   VerticalAlignment="Center" Cursor="SizeAll"
                   Background="Transparent" ToolTip.Tip="Drag to dock the navigation bar"
                   PointerPressed="OnBrandPointerPressed" PointerMoved="OnBrandPointerMoved"
                   PointerReleased="OnBrandPointerReleased" PointerCaptureLost="OnBrandPointerCaptureLost">
                <StackPanel Classes="brandMark" Orientation="Horizontal" Spacing="11"
                            VerticalAlignment="Center">
                    <controls:BrandMark Width="30" Height="30"/>
                    <StackPanel Spacing="1" VerticalAlignment="Center" IsVisible="{Binding ShowBrandText}">
                        <TextBlock Text="DashDetective" FontSize="{DynamicResource TextSizeSubhead}" FontWeight="SemiBold"/>
                        <TextBlock Text="System Information Suite" FontSize="{DynamicResource TextSizeCaption}" Foreground="{DynamicResource TextSubtle}"/>
                    </StackPanel>
                </StackPanel>
            </Panel>

            <!-- User footer: avatar, the user's name (expanded vertical rail only), and the Help button.
                 One cluster serves every state — the avatar and the button bracket the running axis,
                 dropping into a column on a collapsed rail. -->
            <Border Classes="footer" DockPanel.Dock="{Binding FooterDock}"
                    BorderBrush="{DynamicResource Hairline}">
                <DockPanel LastChildFill="True" VerticalAlignment="Center">

                    <!-- The device's account picture when the OS has one, else the initials badge. The
                         accent gradient stays the backdrop either way, so it still re-tints with the
                         accent when there is no picture (and shows through a transparent one).
                         ClipToBounds crops the photo to the circle. -->
                    <Border DockPanel.Dock="{Binding FooterAvatarDock}" Width="32" Height="32"
                            CornerRadius="16" ClipToBounds="True"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding UserTooltip}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="{DynamicResource AccentColor}"/>
                                <GradientStop Offset="1" Color="{DynamicResource AccentDeep}"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Panel>
                            <TextBlock Text="{Binding UserInitials}" FontSize="{DynamicResource TextSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}"
                                       IsVisible="{Binding !HasUserPicture}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding UserPicture}" Stretch="UniformToFill"
                                   IsVisible="{Binding HasUserPicture}"/>
                        </Panel>
                    </Border>

                    <Button Classes="navCtl" DockPanel.Dock="{Binding ControlsDock}"
                            Command="{Binding ShowHelpCommand}" ToolTip.Tip="Help (F1)"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Width="{StaticResource IconSize}" Height="{StaticResource IconSize}" Stretch="Uniform" Stroke="{DynamicResource TextTertiary}"
                              StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                              Data="{x:Static nav:Icons.Help}"/>
                    </Button>

                    <StackPanel Spacing="1" Margin="10,0" VerticalAlignment="Center"
                                IsVisible="{Binding ShowFullFooter}">
                        <TextBlock Text="{Binding UserName}" FontSize="{DynamicResource TextSizeBody}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding UserRole}" FontSize="{DynamicResource TextSizeMini}" Foreground="{DynamicResource TextSubtle}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Navigation (fills the remaining space) -->
            <!-- Inset on the items, not ScrollViewer Padding, which the scroll extent leaves out. -->
            <ScrollViewer x:Name="ItemScroll"
                          VerticalScrollBarVisibility="{Binding ScrollV}"
                          HorizontalScrollBarVisibility="{Binding ScrollH}">
                <ItemsControl x:Name="NavList" ItemsSource="{Binding NavItems}" Margin="12,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="{Binding ItemsOrientation}"
                                        VerticalAlignment="{Binding ItemsVAlign}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="nav:NavItem">
                            <!-- The tooltip is switched off while the label is on screen beside it:
                                 it said nothing the item did not already say. Named outright rather
                                 than through the tooltip, so the name survives either state. -->
                            <Button Classes="nav" Classes.selected="{Binding IsSelected}"
                                    Command="{Binding SelectCommand}"
                                    AutomationProperties.Name="{Binding Label}"
                                    ToolTip.Tip="{Binding Label}"
                                    ToolTip.ServiceEnabled="{Binding !$parent[UserControl].DataContext.ShowLabels}">
                                <Border Classes="navRow" CornerRadius="6">
                                    <Panel>
                                        <Rectangle Classes="navIndicator" Width="3" Height="18"
                                                   RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Rectangle Classes="navIndicatorH" Width="18" Height="3"
                                                   RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                        <!-- Not hit-testable: its negative margins reach past the row, where it
                                             would catch a press meant for the neighbouring item. -->
                                        <Path Classes="sectionsCaret" Width="8" Height="5" Stretch="Uniform"
                                              IsHitTestVisible="False" Data="{x:Static nav:Icons.CaretDown}"/>
                                        <StackPanel Classes="navContent" Orientation="Horizontal" Spacing="12">
                                            <Path Classes="navIcon" Width="{StaticResource IconSize}" Height="{StaticResource IconSize}" Stretch="Uniform"
                                                  Data="{Binding Icon}" StrokeThickness="1.4" StrokeLineCap="Round"
                                                  StrokeJoin="Round" VerticalAlignment="Center"/>
                                            <TextBlock Classes="navLabel" Text="{Binding Label}"
                                                       FontSize="{DynamicResource TextSizeMedium}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Panel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>

        <!-- The current page's sections, opened by pressing its nav item again. The view points it at that
             item (PlacementTarget) and the view model picks the side. Not light-dismissed, so the rest of the
             window stays hoverable; an outside press closes it from code-behind, as the Processes options
             popup does. IsOpen is two-way, so that close reaches the view model. -->
        <Popup x:Name="SectionsPopup" Placement="{Binding SectionsPlacement}"
               IsLightDismissEnabled="False"
               IsOpen="{Binding IsSectionsOpen, Mode=TwoWay}">
            <!-- A popup is its own visual root, so it carries the interface scale itself. -->
            <controls:ScaleHost Scale="{DynamicResource UiScale}">
                <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                        CornerRadius="8" Padding="4" Margin="6"
                        BoxShadow="{StaticResource ShadowPopup}">
                    <StackPanel Spacing="2" MinWidth="200">
                        <TextBlock Classes="dockMenuHeader" Text="ON THIS PAGE"/>
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="nav:PageSectionOption">
                                    <Button Classes="pickTile" Command="{Binding SelectCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            AutomationProperties.Name="{Binding Title}">
                                        <Border Classes="dockRow">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </controls:ScaleHost>
        </Popup>

        <!-- Collapse/expand puck. Every dimension comes from the view model so the semi-circle follows
             the docked edge with no converters, and it reuses the same ToggleCollapse command as the
             Settings control. -->
        <Button Classes="railChevron" Command="{Binding ToggleCollapseCommand}"
                IsVisible="{Binding ShowChevron}"
                Width="{Binding ChevronWidth}" Height="{Binding ChevronHeight}"
                HorizontalAlignment="{Binding ChevronHAlign}" VerticalAlignment="{Binding ChevronVAlign}"
                ToolTip.Tip="Collapse or expand navigation">
            <Border Classes="puck" CornerRadius="{Binding ChevronCornerRadius}">
                <!-- Filled, not stroked: ChevronIcon is one of the Icons.Caret* triangles, the app's
                     one disclosure glyph. Stretch="None" keeps it at its authored 8x5. -->
                <Path Classes="chevronGlyph" Width="18" Height="18" Stretch="None"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="{Binding ChevronIcon}"/>
            </Border>
        </Button>
    </Panel>
</UserControl>
