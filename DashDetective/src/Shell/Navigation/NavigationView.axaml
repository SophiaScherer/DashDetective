<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nav="using:DashDetective.Shell.Navigation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="236" d:DesignHeight="760"
             x:Class="DashDetective.Shell.Navigation.NavigationView"
             x:DataType="nav:NavigationViewModel"
             ClipToBounds="False">

    <UserControl.Styles>
        <!-- Sidebar nav rows. Selection-driven visuals are all sourced from theme/accent resources
             so they follow the current theme and accent. Defaults are the unselected, expanded,
             vertical state; the `.collapsed` and `.horizontal` classes on the root `Border.rail`
             layer on the overrides. Anything that changes with state is set through styles (not
             inline) so the more specific setter wins. -->
        <!-- Strip default button chrome for the nav rows. -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Nav row surface + selection highlight. -->
        <Style Selector="Border.rail Border.navRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="11,9"/>
        </Style>
        <Style Selector="Button.nav.selected Border.navRow">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>

        <!-- Accent indicator: a vertical leading bar on a vertical rail; a bottom underline on a
             horizontal bar. Only one is shown, and only when the row is selected. -->
        <Style Selector="Border.rail Rectangle.navIndicator">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Button.nav.selected Rectangle.navIndicator">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="Border.rail Rectangle.navIndicatorH">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Border.rail.horizontal Button.nav.selected Rectangle.navIndicator">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Border.rail.horizontal Button.nav.selected Rectangle.navIndicatorH">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Icon + label colours. -->
        <Style Selector="Border.rail Path.navIcon">
            <Setter Property="Stroke" Value="{DynamicResource TextTertiary}"/>
        </Style>
        <Style Selector="Button.nav.selected Path.navIcon">
            <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Border.rail TextBlock.navLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style Selector="Button.nav.selected TextBlock.navLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Default (expanded, vertical) layout: icon+label pushed clear of the leading indicator. -->
        <Style Selector="Border.rail StackPanel.navContent">
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- The brand area stretches so the whole strip is a drag handle; the logo and wordmark inside
             it stay left-aligned. -->
        <Style Selector="Border.rail Panel.brand">
            <Setter Property="Margin" Value="18,16,18,14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Border.rail StackPanel.brandMark">
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Collapsed (icons-only) overrides. -->
        <Style Selector="Border.rail.collapsed TextBlock.navLabel">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Border.rail.collapsed Border.navRow">
            <Setter Property="Padding" Value="0,9"/>
        </Style>
        <Style Selector="Border.rail.collapsed StackPanel.navContent">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.rail.collapsed Panel.brand">
            <Setter Property="Margin" Value="0,16,0,14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.rail.collapsed StackPanel.brandMark">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Horizontal (top/bottom) overrides: items flow sideways, icon+label centred, logo-only
             brand, and the row spacing is symmetric. -->
        <Style Selector="Border.rail.horizontal Border.navRow">
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style Selector="Border.rail.horizontal StackPanel.navContent">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.rail.horizontal Panel.brand">
            <Setter Property="Margin" Value="14,0,10,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Footer separator sits on the edge facing the content. -->
        <Style Selector="Border.rail Border.footer">
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
        <Style Selector="Border.rail.horizontal Border.footer">
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
        </Style>

        <!-- On-bar control buttons: the collapse toggle beside the logo, and the Help + orientation
             pair in the footer. -->
        <Style Selector="Button.navCtl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.navCtl:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        </Style>
        <!-- Chrome-less wrapper for the dock menu's rows. -->
        <Style Selector="Button.pickTile">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.pickTile /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Little "panel on this edge" preview beside each dock menu row. -->
        <Style Selector="Border.posTile">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource FieldBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.posTile.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>

        <!-- Right-click dock menu: one row per edge, the current one highlighted. Selection is declared
             after hover so an already-docked row keeps reading as selected while the pointer is on it. -->
        <Style Selector="TextBlock.dockMenuHeader">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}"/>
            <Setter Property="Margin" Value="8,4,8,2"/>
        </Style>
        <Style Selector="Border.dockRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="Button.pickTile:pointerover Border.dockRow">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        </Style>
        <Style Selector="Border.dockRow.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>
        <Style Selector="Border.dockRow TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.dockRow.selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
        </Style>

        <!-- Collapse/expand puck: a semi-circle flush against the bar's content-facing edge, revealed
             only while the pointer is over the bar. Hidden rather than faded (this app uses no
             transitions), and shown from the host panel's :pointerover so the whole bar is the hover
             target, not just the puck. A chrome-less button wrapping a styled Border, the same split as
             the dock menu's `pickTile`/`posTile` pair, so the puck's rounding is its own. -->
        <Style Selector="Button.railChevron">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.railChevron /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Panel.railHost:pointerover Button.railChevron">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <!-- Raised one step off the bar so it reads as sitting on top of the edge, in both themes. -->
        <Style Selector="Border.puck">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Panel.railHost Path.chevronGlyph">
            <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <!-- Hover picks up the accent rather than a fill overlay: the puck is opaque, so a translucent
             overlay would let the content behind it show through. -->
        <Style Selector="Button.railChevron:pointerover Border.puck">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Button.railChevron:pointerover Path.chevronGlyph">
            <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
        </Style>

        <!-- Drag-to-dock: dim the bar where it still sits so it reads as picked up, while the overlay's
             drop band previews the edge it will land on. Declared after the hover rule above so it wins
             — Avalonia takes the last matching setter, not the most specific — which keeps the puck out
             of the way of a moving cursor. -->
        <Style Selector="Panel.railHost.dragging Border.rail">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="Panel.railHost.dragging Button.railChevron">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </UserControl.Styles>

    <!-- ================= SIDEBAR ================= -->
    <!-- The rail plus its edge puck. The puck is a sibling of the rail, not a child, because it stands
         entirely outside it: a negative margin the depth of the half-disc's radius lifts it clear, so only
         its flat side touches the bar's content-facing edge. Two things have to hold for it to draw —
         `ClipToBounds="False"` on this control (it otherwise clips to its docked slot and the puck
         vanishes) and the ZIndex the shell gives the bar (it is the DockPanel's first child, so it would
         paint under the content area). Its negative margin keeps its desired size at zero on that axis,
         so hosting it here does not widen the bar. -->
    <Panel x:Name="RailHost" Classes="railHost" Classes.dragging="{Binding IsDragging}">

    <!-- The rail sizes itself on its docked axis (fixed thickness) and stretches on the other; the
         inner DockPanel lays brand/toggle at the start, footer at the end, and the item list fills
         the middle, with the dock edges flipped for a horizontal bar. -->
    <Border x:Name="RailBorder"
            Classes="rail" Classes.collapsed="{Binding IsCollapsed}" Classes.horizontal="{Binding IsHorizontal}"
            Width="{Binding RailWidth}" Height="{Binding RailHeight}"
            Background="{DynamicResource SidebarBackground}"
            BorderBrush="{DynamicResource Hairline}" BorderThickness="{Binding HairlineThickness}">

        <!-- Right-click anywhere on the bar to re-dock it. Declared once on the rail: ContextRequested
             bubbles, so the brand, the items, the footer and any empty space all reach it. Opens at the
             pointer, and reuses the same NavPositionOption list (and its preview tiles) as the Settings
             control, so all three re-dock paths stay in sync. -->
        <Border.ContextFlyout>
            <Flyout Placement="Pointer">
                <StackPanel Spacing="2" MinWidth="168" Margin="2">
                    <TextBlock Classes="dockMenuHeader" Text="DOCK NAVIGATION"/>
                    <ItemsControl ItemsSource="{Binding Positions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="nav:NavPositionOption">
                                <Button Classes="pickTile" Command="{Binding SelectCommand}"
                                        Margin="0" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch">
                                    <Border Classes="dockRow" Classes.selected="{Binding IsSelected}">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <Border Classes="posTile" Classes.selected="{Binding IsSelected}">
                                                <Panel Margin="3">
                                                    <Rectangle Fill="{DynamicResource Accent}"
                                                               Width="{Binding BarWidth}" Height="{Binding BarHeight}"
                                                               HorizontalAlignment="{Binding BarHAlign}"
                                                               VerticalAlignment="{Binding BarVAlign}"
                                                               RadiusX="1" RadiusY="1"/>
                                                </Panel>
                                            </Border>
                                            <TextBlock Text="{Binding Label}"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Flyout>
        </Border.ContextFlyout>

        <DockPanel LastChildFill="True">

            <!-- Brand. Doubles as the drag handle: press and drag it to re-dock the bar to another
                 window edge (see NavigationView.axaml.cs). The wrapper stretches so the whole brand strip
                 is grabbable while the logo and wordmark inside it stay aligned to the leading edge; its
                 transparent background is what makes the empty part of the strip hit-testable. -->
            <Panel x:Name="BrandArea" Classes="brand" DockPanel.Dock="{Binding BrandDock}"
                   VerticalAlignment="Center" Cursor="SizeAll"
                   Background="Transparent" ToolTip.Tip="Drag to dock the navigation bar"
                   PointerPressed="OnBrandPointerPressed" PointerMoved="OnBrandPointerMoved"
                   PointerReleased="OnBrandPointerReleased" PointerCaptureLost="OnBrandPointerCaptureLost">
                <StackPanel Classes="brandMark" Orientation="Horizontal" Spacing="11"
                            VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="7">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="{DynamicResource AccentColor}"/>
                                <GradientStop Offset="1" Color="{DynamicResource AccentDeep}"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Viewbox Width="16" Height="16">
                            <Path Fill="White"
                                  Data="M2,2 H8 V8 H2 Z M10,2 H16 V8 H10 Z M2,10 H8 V16 H2 Z M10,10 H16 V16 H10 Z"/>
                        </Viewbox>
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center" IsVisible="{Binding ShowBrandText}">
                        <TextBlock Text="System Console" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock Text="Information Suite" FontSize="11" Foreground="{DynamicResource TextSubtle}"/>
                    </StackPanel>
                </StackPanel>
            </Panel>

            <!-- User footer: avatar, the user's name (expanded vertical rail only), and the Help button.
                 One cluster serves every state — the avatar and the button bracket the running axis,
                 dropping into a column on a collapsed rail. -->
            <Border Classes="footer" DockPanel.Dock="{Binding FooterDock}" Padding="14,12"
                    BorderBrush="{DynamicResource Hairline}">
                <DockPanel LastChildFill="True" VerticalAlignment="Center">

                    <Border DockPanel.Dock="{Binding FooterAvatarDock}" Width="32" Height="32"
                            CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding UserTooltip}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="#6ccb5f"/>
                                <GradientStop Offset="1" Color="#3f9c8f"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{Binding UserInitials}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0e0e0e"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Button Classes="navCtl" DockPanel.Dock="{Binding ControlsDock}"
                            Command="{Binding ShowHelpCommand}" ToolTip.Tip="Help"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Width="18" Height="18" Stretch="None" Stroke="{DynamicResource TextTertiary}"
                              StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                              Data="{x:Static nav:Icons.Help}"/>
                    </Button>

                    <StackPanel Spacing="1" Margin="10,0" VerticalAlignment="Center"
                                IsVisible="{Binding ShowFullFooter}">
                        <TextBlock Text="{Binding UserName}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding UserRole}" FontSize="10.5" Foreground="{DynamicResource TextSubtle}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Navigation (fills the remaining space) -->
            <ScrollViewer Padding="12,4"
                          VerticalScrollBarVisibility="{Binding ScrollV}"
                          HorizontalScrollBarVisibility="{Binding ScrollH}">
                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="{Binding ItemsOrientation}"
                                        VerticalAlignment="{Binding ItemsVAlign}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="nav:NavItem">
                            <Button Classes="nav" Classes.selected="{Binding IsSelected}"
                                    Command="{Binding SelectCommand}" ToolTip.Tip="{Binding Label}">
                                <Border Classes="navRow" CornerRadius="6">
                                    <Panel>
                                        <Rectangle Classes="navIndicator" Width="3" Height="18"
                                                   RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Rectangle Classes="navIndicatorH" Width="18" Height="3"
                                                   RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                        <StackPanel Classes="navContent" Orientation="Horizontal" Spacing="12">
                                            <Path Classes="navIcon" Width="18" Height="18" Stretch="None"
                                                  Data="{Binding Icon}" StrokeThickness="1.4" StrokeLineCap="Round"
                                                  StrokeJoin="Round" VerticalAlignment="Center"/>
                                            <TextBlock Classes="navLabel" Text="{Binding Label}"
                                                       FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Panel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>

        <!-- Collapse/expand puck. Every dimension comes from the view model so the semi-circle follows
             the docked edge with no converters, and it reuses the same ToggleCollapse command as the
             Settings control. -->
        <Button Classes="railChevron" Command="{Binding ToggleCollapseCommand}"
                Width="{Binding ChevronWidth}" Height="{Binding ChevronHeight}"
                HorizontalAlignment="{Binding ChevronHAlign}" VerticalAlignment="{Binding ChevronVAlign}"
                Margin="{Binding ChevronMargin}"
                ToolTip.Tip="Collapse or expand navigation">
            <Border Classes="puck" CornerRadius="{Binding ChevronCornerRadius}">
                <Path Classes="chevronGlyph" Width="18" Height="18" Stretch="None"
                      StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="{Binding ChevronIcon}"/>
            </Border>
        </Button>
    </Panel>
</UserControl>
