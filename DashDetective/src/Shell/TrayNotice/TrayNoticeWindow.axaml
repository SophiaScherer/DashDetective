<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="using:DashDetective.Shared.Controls"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="200"
        x:Class="DashDetective.Shell.TrayNotice.TrayNoticeWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="DashDetective"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

    <!-- Shown once, before the first hide-to-tray, while the window the user just closed is still on
         screen. A toast after the fact would have to guess where the tray is; this cannot be missed. -->
    <controls:ScaleHost Scale="{DynamicResource UiScale}">
    <StackPanel Margin="24" Spacing="14">
        <TextBlock Classes="panelTitle" Text="DashDetective keeps running"/>
        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource TextSizeBody}" TextWrapping="Wrap"
                   Text="Closing the window leaves the app running in the system tray, where it goes on monitoring. Open it again from the tray icon, or exit from that icon's menu."/>
        <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextSizeSmall}" TextWrapping="Wrap"
                   Text="Turn this off under Settings → Monitoring → Show in system tray."/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="action" Content="Exit instead" Click="OnExitClick"/>
            <Button Classes="action primary" Content="Keep running" IsDefault="True" Click="OnKeepRunningClick"/>
        </StackPanel>
    </StackPanel>
    </controls:ScaleHost>
</Window>
