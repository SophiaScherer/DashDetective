<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:help="using:DashDetective.Shell.Help"
             xmlns:sc="using:DashDetective.Shared.Shortcuts"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
             x:Class="DashDetective.Shell.Help.HelpOverlay"
             x:DataType="help:HelpViewModel"
             IsVisible="{Binding IsOpen}">

    <UserControl.Styles>
        <!-- The modal's × button. Button.toolIcon lives in MainWindow.Styles (shell-only chrome), so
             the same small-icon-button treatment is restated here rather than reached for. -->
        <Style Selector="Button.helpClose">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.helpClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        </Style>

        <!-- Uppercase section label above a group (the design comp's small-caps heading). -->
        <Style Selector="TextBlock.helpSection">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}"/>
            <Setter Property="LetterSpacing" Value="0.4"/>
        </Style>
    </UserControl.Styles>

    <!-- Scrim. The fixed black-55% is deliberate: it reads as a dimmed window in both themes (same
         reasoning as the shell's fixed-amber alert banner). A non-null Background is also what makes
         the modal modal — it swallows pointer input bound for the window behind it. -->
    <Border x:Name="Scrim" Background="{StaticResource ScrimBackground}" PointerPressed="OnScrimPointerPressed">

        <Border x:Name="Card" Classes="panel" Padding="0" Width="660" MaxHeight="640"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BoxShadow="{StaticResource ShadowModal}">
            <Grid RowDefinitions="Auto,Auto,*">

                <!-- Header -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1"
                        Padding="22,18">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Help &amp; getting started" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextStrong}"/>
                            <TextBlock Text="{Binding VersionText}" FontSize="11.5"
                                       Foreground="{DynamicResource TextSubtle}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="helpClose" ToolTip.Tip="Close"
                                Command="{Binding CloseCommand}">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                  StrokeLineCap="Round" Data="M1,1 L11,11 M11,1 L1,11"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Tab strip. Overview is a filter over the sections below rather than a section of
                     its own, so each one is written once and shown by its ShowX flag. -->
                <Border Grid.Row="1" Classes="segments" Margin="22,16,22,0">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="help:HelpTabOption">
                                <Button Classes="bare" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding SelectCommand}">
                                    <Border Classes="seg" Classes.selected="{Binding IsSelected}">
                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center"/>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Body. The inset is the content's Margin, not the ScrollViewer's Padding: Avalonia
                     leaves ScrollViewer Padding out of the scroll extent, so a bottom padding here
                     would make the last tip unreachable. -->
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,20,22,24" Spacing="20">

                        <!-- What the app is, then a line per page in navigation order. -->
                        <StackPanel Spacing="18" IsVisible="{Binding ShowGettingStarted}">
                            <TextBlock Text="{Binding Description}" FontSize="13" LineHeight="21"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>

                            <StackPanel Spacing="10">
                                <TextBlock Classes="helpSection" Text="GETTING STARTED"/>
                                <ItemsControl ItemsSource="{Binding GettingStarted}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="11"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="help:HelpTopic">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextStrong}"/>
                                                <TextBlock Text="{Binding Body}" FontSize="12.5"
                                                           LineHeight="19" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="10" IsVisible="{Binding ShowTips}">
                            <TextBlock Classes="helpSection" Text="TIPS"/>
                            <ItemsControl ItemsSource="{Binding Tips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="9"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="help:HelpTopic">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Text="•" FontSize="12.5"
                                                       Foreground="{DynamicResource Accent}"/>
                                            <TextBlock Grid.Column="1" Margin="9,0,0,0" Text="{Binding Body}"
                                                       FontSize="12.5" LineHeight="19" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Keyboard shortcuts, rendered from the same catalog the key handler
                             resolves against, so this list can never describe a binding that isn't
                             live (or miss one that is). -->
                        <StackPanel Spacing="12" IsVisible="{Binding ShowShortcuts}">
                            <TextBlock Classes="helpSection" Text="KEYBOARD SHORTCUTS"/>
                            <ItemsControl ItemsSource="{Binding ShortcutGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="16"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sc:ShortcutGroup">
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextStrong}"/>
                                            <ItemsControl ItemsSource="{Binding Shortcuts}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="6"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="sc:Shortcut">
                                                        <Grid ColumnDefinitions="150,*">
                                                            <Border Grid.Column="0" HorizontalAlignment="Left"
                                                                    Background="{DynamicResource FieldBackground}"
                                                                    BorderBrush="{DynamicResource Hairline}"
                                                                    BorderThickness="1" CornerRadius="4"
                                                                    Padding="7,2">
                                                                <TextBlock Text="{Binding Keys}" FontSize="11.5"
                                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                                       Text="{Binding Description}"
                                                                       FontSize="12.5" LineHeight="19"
                                                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextSecondary}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Border>
</UserControl>
