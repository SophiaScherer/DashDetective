<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:DashDetective.Shared.Controls"
             xmlns:nav="using:DashDetective.Shell.Navigation"
             xmlns:search="using:DashDetective.Shell.Search"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="34"
             x:DataType="search:UniversalSearchViewModel"
             x:Class="DashDetective.Shell.Search.UniversalSearchView">

    <UserControl.Styles>
        <!-- Result rows. The ListBox is used (rather than the hand-rolled ItemsControl tables the data
             pages use) because selection, keyboard traversal and scroll-into-view are exactly what a
             dropdown needs and exactly what it already provides. Fluent's own item chrome is stripped
             back to the app's hover/selected overlays. -->
        <Style Selector="ListBox.results">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.results ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBox.results ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.results ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        </Style>
        <!-- Listed after hover so the keyboard's position stays legible under the pointer. -->
        <Style Selector="ListBox.results ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>
        <Style Selector="ListBox.results ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>

        <!-- Collapsed state: the same 34px icon button as Refresh and Export beside it, so the
             toolbar reads as one row of actions until the field is asked for. -->
        <Style Selector="Button.searchIcon">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusField}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.searchIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
        </Style>

        <!-- The category tag at the right of a row (Page / Setting / Process / File). -->
        <Style Selector="Border.resultTag">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- Collapsed: an icon in the toolbar's action row. Clicking it shows the field and takes the
             caret, the same entry point Ctrl+F uses. -->
        <Button Classes="searchIcon" IsVisible="{Binding !IsExpanded}"
                ToolTip.Tip="Search (Ctrl+F)" Click="OnExpandClick"
                HorizontalAlignment="Right" VerticalAlignment="Center">
            <Path Width="16" Height="16" Stretch="Uniform" Data="{x:Static nav:Icons.Search}"
                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5" StrokeLineCap="Round"/>
        </Button>

        <!-- PointerPressed as well as GotFocus: after picking a result the caret stays in the box, so
             clicking it again raises no focus event and the dropdown would never come back. Both events
             bubble out of the field's inner box, so they still reach these handlers.
             Tab fills in the best result's name; Enter is bound inside the field because the shortcut
             layer deliberately leaves Enter to whatever text box has focus. -->
        <controls:SearchField x:Name="SearchBox" Height="34" ToolTip.Tip="Search (Ctrl+F)"
                              IsVisible="{Binding IsExpanded}"
                              MinWidth="180" MaxWidth="320"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              PointerPressed="OnFieldPressed"
                              GotFocus="OnSearchBoxGotFocus"
                              LostFocus="OnSearchBoxLostFocus"
                              PlaceholderText="Search pages, settings, processes, files…"
                              ClearToolTip="Clear search"
                              Text="{Binding Text, Mode=TwoWay}"
                              Completion="{Binding Completion}"
                              EnterCommand="{Binding ActivateSelectedCommand}"
                              ClearCommand="{Binding ClearCommand}"/>

        <!-- Overlay-free so the caret stays in the box while results are showing — a light-dismiss popup
             takes focus, which would stop the user typing. Close-on-outside-click is emulated in the
             code-behind, the same trade the File Explorer's Options menu makes. -->
        <Popup x:Name="ResultsPopup" PlacementTarget="{Binding #SearchBox}"
               Placement="BottomEdgeAlignedLeft" VerticalOffset="6"
               IsLightDismissEnabled="False" Focusable="False"
               Width="{Binding #SearchBox.Bounds.Width}"
               IsOpen="{Binding IsOpen}">
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                    CornerRadius="8" Padding="6" BoxShadow="0 8 24 0 #22000000">
                <Panel>
                    <!-- Exactly one of these three shows at a time (see the view model): a blank card
                         while the filesystem answers would read as "nothing found". -->
                    <TextBlock Text="Searching…" Margin="10,12" FontSize="12.5"
                               Foreground="{DynamicResource TextSubtle}"
                               IsVisible="{Binding ShowSearching}"/>
                    <TextBlock Text="No matches" Margin="10,12" FontSize="12.5"
                               Foreground="{DynamicResource TextSubtle}"
                               IsVisible="{Binding ShowNoResults}"/>

                    <ListBox Classes="results" ItemsSource="{Binding Results}"
                             SelectedIndex="{Binding SelectedIndex}"
                             SelectionChanged="OnResultsSelectionChanged"
                             MaxHeight="380" IsVisible="{Binding ShowResultList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="search:SearchResult">
                                <Border Background="Transparent" Padding="10,7" Tapped="OnResultTapped">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Path Grid.Column="0" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.3"
                                              StrokeLineCap="Round" StrokeJoin="Round"
                                              VerticalAlignment="Center" Data="{Binding Icon}"
                                              IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <StackPanel Grid.Column="1" Margin="10,0" Spacing="1">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSubtle}"
                                                       IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="resultTag">
                                            <TextBlock Text="{Binding CategoryLabel}" FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Panel>
            </Border>
        </Popup>
    </Panel>
</UserControl>
